<section class="mtw-section mtw-section--card-bg">
  <div class="mtw-container">
    <div class="mtw-season-grid">

      <!-- Left: brand statement -->
      <div class="mtw-season-statement">
        <span class="mtw-mono mtw-eyebrow mtw-eyebrow--muted">Every season</span>
        <h2 class="mtw-h1-display">
          All seasons,<br>
          curated by your<br>
          <em class="mtw-text-primary" style="font-style:normal">favorite team.</em>
        </h2>
        <p class="mtw-body mtw-text-muted" style="max-width:22rem">
          Fall is just the beginning. We come back every season with the same team and the same care. Your door always feels ready.
        </p>
      </div>

      <!-- Right: season cards -->
      <div class="mtw-season-cards">

        <div class="mtw-season-card">
          <div class="mtw-season-card__header">
            <div>
              <p class="mtw-season-card__name">Winter</p>
              <span class="mtw-mono mtw-text-muted" style="font-size:0.65rem;letter-spacing:0.1em;text-transform:uppercase">2026–27</span>
            </div>
            <span class="mtw-badge mtw-badge--sage">2026 ledger</span>
          </div>
          <p class="mtw-body-sm mtw-text-muted" style="margin-bottom:1.5rem">
            Custom garland installed and dressed for the season, then quietly removed when the holidays are over.
          </p>
          <a href="/pages/winter" class="mtw-link-arrow">
            Add your name
            <svg width="12" height="12" viewBox="0 0 14 14" fill="none">
              <path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>

        <div class="mtw-season-card">
          <div class="mtw-season-card__header">
            <div>
              <p class="mtw-season-card__name">Summer</p>
              <span class="mtw-mono mtw-text-muted" style="font-size:0.65rem;letter-spacing:0.1em;text-transform:uppercase">2027</span>
            </div>
            <span class="mtw-badge mtw-badge--sage">2027 ledger</span>
          </div>
          <p class="mtw-body-sm mtw-text-muted" style="margin-bottom:1.5rem">
            Seasonal flag installs that make your home feel festive and finished from the moment summer arrives.
          </p>
          <a href="/pages/summer" class="mtw-link-arrow">
            Add your name
            <svg width="12" height="12" viewBox="0 0 14 14" fill="none">
              <path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>

      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Season Cards",
  "settings": [],
  "presets": [
    { "name": "Season Cards" }
  ]
}
{% endschema %}

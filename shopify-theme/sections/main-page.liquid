<style>
.main-page { padding: var(--spacing-xl) 0; max-width: 800px; margin: 0 auto; }
.main-page__title { font-family: var(--font-serif); font-size: 3.5rem; text-align: center; margin-bottom: var(--spacing-lg); }
.main-page__content { font-size: 1rem; line-height: 1.8; color: var(--color-muted); }
.main-page__content h2, .main-page__content h3 { color: var(--color-foreground); margin-top: var(--spacing-md); }
</style>

<div class="container main-page">
  <h1 class="main-page__title">{{ page.title }}</h1>
  <div class="main-page__content rte">
    {{ page.content }}
  </div>
</div>

{% schema %}
{
  "name": "Page Content",
  "settings": []
}
{% endschema %}
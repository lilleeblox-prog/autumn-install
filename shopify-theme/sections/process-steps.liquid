<style>
.process-section { padding: var(--spacing-xl) 0; background-color: var(--color-foreground); color: var(--color-background); }
.process-section__header { text-align: center; margin-bottom: var(--spacing-lg); }
.process-section__header .eyebrow { color: var(--color-accent); }
.process-section h1, .process-section h2 { color: var(--color-background); font-size: 3.5rem; }
.process-section__header > p { max-width: 720px; margin: 0 auto; line-height: 1.7; }
.process-section p { color: var(--color-muted); }
.process-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--spacing-lg); }
.process-step { position: relative; }
.process-step::before {
  content: '';
  position: absolute;
  top: 15px;
  left: 0;
  width: 100%;
  height: 1px;
  background: var(--color-accent);
  z-index: 1;
}
.process-step__number {
  position: relative;
  z-index: 2;
  display: inline-flex;
  width: 32px;
  height: 32px;
  background: var(--color-foreground);
  border: 1px solid var(--color-accent);
  color: var(--color-accent);
  align-items: center;
  justify-content: center;
  font-family: var(--font-mono);
  font-size: 0.75rem;
  margin-bottom: var(--spacing-sm);
}
.process-step h3 { color: var(--color-background); font-size: 1.25rem; font-family: var(--font-sans); font-weight: 600; margin-bottom: 0.5rem; }
.process-step p { font-size: 0.875rem; line-height: 1.6; }
.process-section__action { display: flex; justify-content: center; margin-top: var(--spacing-lg); }

@media (max-width: 768px) {
  .process-grid { grid-template-columns: 1fr; gap: var(--spacing-md); }
  .process-step::before { display: none; }
}
</style>

<section class="process-section" id="{{ section.settings.section_id }}">
  <div class="container">
    <div class="process-section__header">
      {% if section.settings.eyebrow != blank %}<div class="eyebrow">{{ section.settings.eyebrow | escape }}</div>{% endif %}
      {% if template.name == 'page' %}<h1>{{ section.settings.title | escape }}</h1>{% else %}<h2>{{ section.settings.title | escape }}</h2>{% endif %}
      <p>{{ section.settings.text | escape }}</p>
    </div>
    
    <div class="process-grid">
      {% for block in section.blocks %}
        <div class="process-step">
          <div class="process-step__number">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</div>
          {% if block.settings.kicker != blank %}<div class="eyebrow">{{ block.settings.kicker | escape }}</div>{% endif %}
          <h3>{{ block.settings.title | escape }}</h3>
          <p>{{ block.settings.text | escape }}</p>
        </div>
      {% endfor %}
    </div>
    {% if section.settings.button_label != blank %}
      <div class="process-section__action">
        {% assign process_button_link = section.settings.button_link %}
        {% if process_button_link == blank or process_button_link == '#compose' %}
          {% assign process_button_link = routes.root_url %}
          {% assign process_button_anchor = true %}
        {% else %}
          {% assign process_button_anchor = false %}
        {% endif %}
        <a class="button button--accent" href="{{ process_button_link }}{% if process_button_anchor %}#compose{% endif %}">{{ section.settings.button_label | escape }}</a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Process Steps",
  "settings": [
    {
      "type": "text",
      "id": "section_id",
      "label": "Section ID",
      "default": "process"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "A considered way in."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Our approach / From idea to entrance"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Create your design"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "kicker",
          "label": "Step eyebrow"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Process Steps"
    }
  ]
}
{% endschema %}
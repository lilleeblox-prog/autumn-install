<section class="mtw-section mtw-section--bordered">
  <div class="mtw-container">
    <div class="mtw-two-col">

      <!-- What we do -->
      <div class="mtw-two-col__col">
        <span class="mtw-mono mtw-eyebrow mtw-eyebrow--muted">The service</span>
        <h2 class="mtw-h2" style="margin-bottom:1.75rem">Pumpkins, gourds, hay bales. All of it handled.</h2>
        <div class="mtw-prose">
          <p>
            We select the pumpkins, source the gourds and hay bales, and arrange everything at your front door. You never touch a thing. When autumn ends, we come back and collect it all if you want us to.
          </p>
          <ul class="mtw-checklist">
            <li>Organic pumpkins and heirloom gourds, arranged for your specific entry</li>
            <li>Hay bales for height, structure, and that unmistakable fall feel</li>
            <li>Planter styling with fall foliage and seasonal fillers</li>
            <li>Full delivery and installation. We bring everything.</li>
            <li>Optional removal mid-to-end of November so your entry is clear for December 1st</li>
          </ul>
          <p>
            Every pumpkin and gourd is sourced fresh for the season. We do not offer storage. Add the removal service and we collect everything mid-to-end of November so your entry is clear and ready for December 1st.
          </p>
        </div>
      </div>

      <!-- How it unfolds -->
      <div class="mtw-two-col__col">
        <span class="mtw-mono mtw-eyebrow mtw-eyebrow--muted">The process</span>
        <h2 class="mtw-h2" style="margin-bottom:1.75rem">How it unfolds.</h2>
        <div class="mtw-process-list">
          <div class="mtw-process-item mtw-process-item--active">
            <div class="mtw-process-item__dot mtw-process-item__dot--active"></div>
            <div>
              <p class="mtw-process-item__period">Now through Mid-August</p>
              <p class="mtw-process-item__body">Add your name and we'll reach out when ordering opens in mid-August. No payment now.</p>
            </div>
          </div>
          <div class="mtw-process-item mtw-process-item--active">
            <div class="mtw-process-item__dot mtw-process-item__dot--active"></div>
            <div>
              <p class="mtw-process-item__period">Mid-August 2026</p>
              <p class="mtw-process-item__body">Ordering opens. We reach out to walk you through your package options and schedule your install.</p>
            </div>
          </div>
          <div class="mtw-process-item">
            <div class="mtw-process-item__dot"></div>
            <div>
              <p class="mtw-process-item__period">Late September – October</p>
              <p class="mtw-process-item__body">Our team arrives with your pumpkins, gourds, and all the fall pieces. We arrange everything at your door by hand.</p>
            </div>
          </div>
          <div class="mtw-process-item">
            <div class="mtw-process-item__dot"></div>
            <div>
              <p class="mtw-process-item__period">Mid–End of November (optional)</p>
              <p class="mtw-process-item__body">We come back to collect your pumpkins, gourds, and hay bales so your entry is clear and ready for December 1st. Nothing to bag up, nothing to store.</p>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Fall — Content",
  "settings": [],
  "presets": [
    { "name": "Fall — Content" }
  ]
}
{% endschema %}

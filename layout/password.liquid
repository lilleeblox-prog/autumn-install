<!DOCTYPE html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <title>{{ shop.name }} &ndash; Coming Soon</title>
    {{ content_for_header }}
    <style>
      body { font-family: 'DM Sans', sans-serif; background: #eeece7; color: #2e302d; text-align: center; padding: 100px 20px; }
      h1 { font-family: 'Instrument Serif', serif; font-size: 3rem; font-weight: normal; margin-bottom: 10px; }
      input[type="password"] { padding: 10px; border: 1px solid #d9d5cc; background: transparent; margin-right: 10px; }
      button { padding: 10px 20px; background: #2e302d; color: #eeece7; border: none; cursor: pointer; text-transform: uppercase; font-size: 0.75rem; font-family: monospace; }
    </style>
  </head>
  <body>
    <h1>{{ shop.name }}</h1>
    <p>We are currently composing our seasonal offering. Enter your password to access the studio.</p>
    {% form 'storefront_password' %}
      {{ form.errors | default_errors }}
      <input type="password" name="password" id="Password" placeholder="Your password" autofocus>
      <button type="submit">Enter</button>
    {% endform %}
    {{ content_for_layout }}
  </body>
</html>
<section class="mtw-section mtw-contact">
  <div class="mtw-container">
    <div class="mtw-contact__header">
      <span class="mtw-mono mtw-eyebrow mtw-eyebrow--primary">Get in touch</span>
      <h1 class="mtw-h1">We'd love to hear from you.</h1>
      <p class="mtw-body mtw-text-muted" style="max-width:32rem">
        Questions about our service, availability in your neighborhood, or anything else — reach out and we'll get back to you promptly.
      </p>
    </div>

    <div class="mtw-two-col mtw-two-col--asymmetric">

      <!-- Left: details -->
      <div class="mtw-two-col__col">
        <div class="mtw-contact-detail">
          <p class="mtw-mono mtw-contact-detail__label">Service area</p>
          <p>Tennessee — Franklin, Brentwood, Belle Meade, and surrounding neighborhoods.</p>
        </div>
        <div class="mtw-contact-detail">
          <p class="mtw-mono mtw-contact-detail__label">Season</p>
          <p>Fall 2026 is currently accepting new doors. Winter and Summer services are coming soon.</p>
        </div>
        <div class="mtw-contact-detail">
          <p class="mtw-mono mtw-contact-detail__label">Response time</p>
          <p>We reply within one business day.</p>
        </div>
      </div>

      <!-- Right: form -->
      <div class="mtw-two-col__col">
        <div class="mtw-form-card">
          {%- form 'contact' -%}
            {%- if form.posted_successfully? -%}
              <div class="mtw-form-success">
                <p class="mtw-form-success__title">Message received.</p>
                <p class="mtw-form-success__body">Thank you for reaching out. We'll be in touch within one business day.</p>
              </div>
            {%- else -%}
              <div class="mtw-form-row mtw-form-row--2col">
                <div class="mtw-form-field">
                  <label class="mtw-label" for="contact-name">Name</label>
                  <input class="mtw-input" type="text" id="contact-name" name="contact[name]" placeholder="Jane Smith" required>
                </div>
                <div class="mtw-form-field">
                  <label class="mtw-label" for="contact-email">Email</label>
                  <input class="mtw-input" type="email" id="contact-email" name="contact[email]" placeholder="jane@example.com" required>
                </div>
              </div>
              <div class="mtw-form-field">
                <label class="mtw-label" for="contact-phone">Phone</label>
                <input class="mtw-input" type="tel" id="contact-phone" name="contact[phone]" placeholder="(615) 555-0100" required>
              </div>
              <div class="mtw-form-field">
                <label class="mtw-label" for="contact-body">Message</label>
                <textarea class="mtw-input mtw-textarea" id="contact-body" name="contact[body]" rows="5" placeholder="Tell us about your home, neighborhood, or any questions you have." required></textarea>
              </div>
              <button type="submit" class="mtw-btn mtw-btn--primary">Send message</button>
            {%- endif -%}
          {%- endform -%}
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact Form",
  "settings": [],
  "presets": [
    { "name": "Contact Form" }
  ]
}
{% endschema %}

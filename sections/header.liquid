<header class="site-header">
  {% capture canonical_navigation %}
    {% assign process_href = routes.root_url | append: '#process' %}
    {% if pages.process != blank %}{% assign process_href = pages.process.url %}{% endif %}
    <a href="{{ process_href }}" class="site-header__nav-link"{% if pages.process != blank and request.path == pages.process.url %} aria-current="page"{% endif %}>Process</a>
    <a href="{{ routes.root_url }}#compose" class="site-header__nav-link">Compose</a>
    {% if pages.gallery != blank %}
      <a href="{{ pages.gallery.url }}" class="site-header__nav-link"{% if request.path == pages.gallery.url %} aria-current="page"{% endif %}>Gallery</a>
    {% else %}
      <a href="{{ routes.root_url }}#gallery" class="site-header__nav-link">Gallery</a>
    {% endif %}
    {% if pages.faq != blank %}
      <a href="{{ pages.faq.url }}" class="site-header__nav-link"{% if request.path == pages.faq.url %} aria-current="page"{% endif %}>FAQ</a>
    {% else %}
      <a href="{{ routes.root_url }}#faq" class="site-header__nav-link">FAQ</a>
    {% endif %}
    {% if pages.contact != blank %}
      <a href="{{ pages.contact.url }}" class="site-header__nav-link"{% if request.path == pages.contact.url %} aria-current="page"{% endif %}>Contact</a>
    {% else %}
      <a href="{{ routes.root_url }}#consultation-form" class="site-header__nav-link">Contact</a>
    {% endif %}
  {% endcapture %}
  <div class="container site-header__inner">
    <a href="{{ routes.root_url }}" class="site-header__logo" aria-label="Palette Install home">
      {{ section.settings.wordmark }}
    </a>
    
    <button class="site-header__menu-toggle" type="button" aria-expanded="false" aria-controls="MobileNav" aria-label="Open navigation menu" data-menu-toggle>
      Menu
    </button>

    <nav class="site-header__nav" aria-label="Main navigation">
      {{ canonical_navigation }}
    </nav>
    
    <div class="site-header__icons">
      <a href="{{ routes.cart_url }}" class="site-header__cart" id="cart-icon-bubble" aria-label="Your design{% if cart.item_count > 0 %}, {{ cart.item_count }} items{% else %}, empty{% endif %}">
        Your design
        {% if cart.item_count > 0 %}
          <span class="cart-count" aria-hidden="true">{{ cart.item_count }}</span>
        {% endif %}
      </a>
    </div>
  </div>

  <nav id="MobileNav" class="container mobile-nav hidden" data-mobile-nav aria-label="Mobile navigation">
    {{ canonical_navigation }}
  </nav>
</header>

<script>
  (() => {
    const bindFaqAnchor = () => {
      const faqSection = document.querySelector('.faq-section');
      if (!faqSection) return;
      faqSection.id = 'faq';
      if (window.location.hash === '#faq') {
        requestAnimationFrame(() => faqSection.scrollIntoView({ behavior: 'smooth', block: 'start' }));
      }
    };
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', bindFaqAnchor, { once: true });
    } else {
      bindFaqAnchor();
    }
  })();
</script>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "html",
      "id": "wordmark",
      "label": "Wordmark (HTML)",
      "default": "palette<span>/</span>install",
      "info": "Use <span> for the accent color."
    },
    {
      "type": "link_list",
      "id": "menu",
      "default": "main-menu",
      "label": "Menu"
    }
  ]
}
{% endschema %}
<header class="mtw-header">
  <div class="mtw-header__inner">
    <a href="{{ routes.root_url }}" class="mtw-header__logo">Made to Welcome</a>

    <nav class="mtw-header__nav" aria-label="Main navigation">
      <a href="/pages/fall" class="mtw-nav-link">Fall</a>
      <a href="/pages/winter" class="mtw-nav-link">Winter</a>
      <a href="/pages/summer" class="mtw-nav-link">Summer</a>
      <a href="/pages/contact" class="mtw-nav-link">Contact</a>
      <a href="/#packages" class="mtw-btn mtw-btn--dark">Order now</a>
    </nav>

    <a href="/cart" class="mtw-header__cart" aria-label="Cart">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
      </svg>
      {%- if cart.item_count > 0 -%}
        <span class="mtw-header__cart-badge">{{ cart.item_count }}</span>
      {%- endif -%}
    </a>

    <button class="mtw-header__hamburger" aria-label="Open menu" aria-expanded="false" id="hamburger-btn">
      <span></span><span></span><span></span>
    </button>
  </div>

  <div class="mtw-mobile-nav" id="mobile-nav" aria-hidden="true">
    <a href="/pages/fall" class="mtw-mobile-nav__link">Fall</a>
    <a href="/pages/winter" class="mtw-mobile-nav__link">Winter</a>
    <a href="/pages/summer" class="mtw-mobile-nav__link">Summer</a>
    <a href="/pages/contact" class="mtw-mobile-nav__link">Contact</a>
    <a href="/#packages" class="mtw-btn mtw-btn--dark" style="display:inline-block;margin-top:0.5rem">Order now</a>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": []
}
{% endschema %}

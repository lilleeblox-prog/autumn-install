<style>
.cart-page { max-width: 1080px; padding: clamp(70px, 9vw, 138px) 0 clamp(90px, 11vw, 160px); }
.cart-header { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: end; gap: 3rem; margin-bottom: clamp(30px, 5vw, 70px); border-bottom: 1px solid var(--color-border); padding-bottom: clamp(32px, 5vw, 62px); }
.cart-header .eyebrow { margin-bottom: 28px; }
.cart-header h1 { max-width: 820px; font-size: clamp(4.3rem, 8.2vw, 8.8rem); line-height: .88; letter-spacing: -.052em; margin: 0 0 26px; }
.cart-header p { max-width: 32rem; color: var(--color-muted); font-size: .92rem; line-height: 1.8; margin: 0; }
.cart-continue { flex-shrink: 0; align-self: end; border-bottom: 1px solid var(--color-accent); color: var(--color-accent); font-size: .65rem; font-weight: 700; letter-spacing: .12em; line-height: 1.8; text-transform: uppercase; padding-bottom: .35rem; margin-bottom: .2rem; }
.cart-continue:hover { color: var(--color-foreground); border-color: var(--color-foreground); }
.cart-items { border-top: 1px solid var(--color-border); }
.cart-item { display: grid; grid-template-columns: 126px minmax(0, 1fr) auto; gap: clamp(20px, 3vw, 44px); padding: clamp(26px, 3.5vw, 48px) 0; border-bottom: 1px solid var(--color-border); }
.cart-item__image { border: 0; background: var(--color-stone); overflow: hidden; }
.cart-item__image img { width: 100%; aspect-ratio: 4/5; object-fit: cover; display: block; }
.cart-item__info { min-width: 0; }
.cart-item__info h3 { margin: 0 0 .6rem; font-family: var(--font-serif); font-size: clamp(1.8rem, 3vw, 2.6rem); font-weight: 400; letter-spacing: -.025em; line-height: 1; }
.cart-item__info h3 a:hover { color: var(--color-accent); }
.cart-item__variant { font-size: .73rem; color: var(--color-muted); margin-bottom: .25rem; }
.cart-item__properties { font-size: .73rem; color: var(--color-muted); margin-top: .8rem; }
.cart-item__properties dl { margin: .7rem 0; }
.cart-item__properties .property-line { display: flex; flex-wrap: wrap; gap: .25rem; margin: .3rem 0; line-height: 1.55; }
.cart-item__properties dt { display: inline; font-weight: 600; color: var(--color-foreground); }
.cart-item__properties dd { display: inline; margin: 0 0 0 .15rem; overflow-wrap: anywhere; }
.cart-item__properties a { color: var(--color-accent); text-decoration: underline; text-underline-offset: 3px; }
.cart-item__price { font-family: var(--font-serif); font-size: 1.55rem; line-height: 1; margin-top: 1.1rem; }
.cart-item__remove { font-family: var(--font-mono); font-size: .62rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--color-accent); text-decoration: underline; text-underline-offset: 3px; margin-top: 1rem; display: inline-block; }
.cart-item--grouped[data-service-kind]:not([data-service-kind=""]) .cart-item__remove { text-decoration: none; color: var(--color-muted); pointer-events: none; }
.cart-item__remove[data-remove-composition] { border: 0; background: transparent; padding: 0; cursor: pointer; font: inherit; }
.cart-item__edit { display: inline-block; margin-top: .75rem; font-size: .73rem; font-weight: 600; text-decoration: underline; text-underline-offset: 3px; color: var(--color-accent); }
.cart-item__totals { padding-top: .25rem; }
.cart-item--grouped .quantity__input { background: var(--color-stone); pointer-events: none; }
.cart-item--grouped .quantity__button { display: none; }
.no-js #cart.cart-has-grouped .cart-buttons { display: none; }
.cart-noscript { display: none; }
.no-js #cart.cart-has-grouped .cart-noscript { display: block; color: var(--color-accent); font-size: .8rem; line-height: 1.6; }

.cart-footer { margin-top: clamp(36px, 6vw, 76px); margin-left: auto; max-width: 620px; border: 1px solid var(--color-border); padding: clamp(24px, 4vw, 44px); background: var(--color-panel); }
.cart-subtotal { display: flex; justify-content: space-between; align-items: baseline; gap: 24px; font-family: var(--font-serif); font-size: clamp(1.7rem, 3vw, 2.35rem); line-height: 1; margin-bottom: 1.1rem; }
.cart-note { font-size: .73rem; color: var(--color-muted); line-height: 1.7; margin-bottom: 1.8rem; }
.cart-buttons { display: flex; justify-content: flex-end; gap: .7rem; }
.cart-buttons .button { min-height: 54px; padding-inline: 18px; font-size: .62rem; }
.cart-empty { text-align: center; padding: clamp(90px, 13vw, 180px) 0; }
.cart-empty .eyebrow { margin-bottom: 25px; }
.cart-empty h2 { font-size: clamp(3.4rem, 7vw, 6.5rem); line-height: .92; letter-spacing: -.045em; margin: 0 auto 22px; max-width: 760px; }
.cart-empty p { color: var(--color-muted); line-height: 1.8; margin: 0 auto 32px; max-width: 440px; }

@media (max-width: 700px) {
  .cart-page { padding-top: 72px; }
  .cart-header { grid-template-columns: 1fr; gap: 24px; }
  .cart-header .eyebrow { margin-bottom: 24px; }
  .cart-header h1 { font-size: clamp(4.2rem, 14vw, 6.2rem); margin-bottom: 22px; }
  .cart-header .cart-continue { justify-self: start; }
  .cart-item { grid-template-columns: 82px minmax(0, 1fr); gap: 17px; }
  .cart-item__totals { grid-column: 2; display: flex; justify-content: space-between; align-items: center; padding-top: 0; }
  .cart-item__info h3 { font-size: 1.8rem; }
  .cart-item__price { font-size: 1.4rem; }
  .cart-buttons { flex-direction: column; }
  .cart-buttons .button { width: 100%; }
}
@media (max-width: 390px) {
  .cart-item { grid-template-columns: 68px minmax(0, 1fr); gap: 13px; }
  .cart-item__info h3 { font-size: 1.55rem; }
  .cart-subtotal { font-size: 1.65rem; }
}
</style>

<div class="container cart-page">
  <div class="cart-header">
    <div>
      <span class="eyebrow">The final details</span>
      <h1>Your composition</h1>
      <p>Take a moment with your design. Every element can be reviewed before you proceed.</p>
    </div>
    <a href="{{ routes.root_url }}#compose" class="cart-continue">Explore more designs &rarr;</a>
  </div>

  {% if cart.item_count > 0 %}
    {% assign has_grouped = false %}
    {% for grouped_item in cart.items %}
      {% if grouped_item.properties['_Composition ID'] != blank %}{% assign has_grouped = true %}{% endif %}
    {% endfor %}
    <form action="{{ routes.cart_url }}" method="post" id="cart"{% if has_grouped %} class="cart-has-grouped"{% endif %}>
      <div class="cart-items">
        {% for item in cart.items %}
          {% assign composition_id = item.properties['_Composition ID'] %}
          {% assign service_kind = item.properties['_Service Kind'] %}
          {% assign artwork_choice = item.properties['Vinyl Artwork'] | default: item.properties['Monogram'] %}
          {% assign artwork_quantity = item.properties['Vinyl-wrapped Pumpkins'] | default: item.properties['Monogrammed Pumpkins'] %}
          {% assign artwork_url_https = item.properties['Artwork File'] | slice: 0, 24 %}
          {% assign artwork_url_relative = item.properties['Artwork File'] | slice: 0, 18 %}
          {% assign has_uploaded_artwork = false %}
          {% if artwork_url_https == 'https://cdn.shopify.com/' or artwork_url_relative == '//cdn.shopify.com/' %}
            {% assign has_uploaded_artwork = true %}
          {% endif %}
          <div class="cart-item{% if composition_id != blank %} cart-item--grouped{% endif %}" data-cart-item data-line-key="{{ item.key | escape }}" data-composition-id="{{ composition_id | escape }}" data-service-kind="{{ service_kind | escape }}" data-item-quantity="{{ item.quantity }}" data-display-size="{{ item.product.handle | split: '-' | first | escape }}" data-service="{{ item.properties['Service'] | escape }}" data-hay="{{ item.properties['Hay Bales'] | escape }}" data-monogram="{{ artwork_choice | escape }}" data-monogram-qty="{{ artwork_quantity | escape }}" data-artwork-required="{% if item.properties['Vinyl Artwork'] == 'Yes' %}true{% else %}false{% endif %}" data-artwork-present="{{ has_uploaded_artwork }}" data-removal="{{ item.properties['Removal'] | escape }}">
            <div class="cart-item__image">
              {% if item.image %}
                <img src="{{ item.image | image_url: width: 200 }}" width="{{ item.image.width }}" height="{{ item.image.height }}" alt="{{ item.image.alt | escape }}" loading="lazy">
              {% endif %}
            </div>
            <div class="cart-item__info">
                <h3><a href="{{ item.url }}">{% if service_kind == 'monogram' %}Vinyl artwork · per pumpkin{% else %}{{ item.product.title | escape }}{% endif %}</a></h3>
              {% unless item.product.has_only_default_variant %}
                <div class="cart-item__variant">{{ item.variant.title }}</div>
              {% endunless %}
              
              {%- if item.properties.size > 0 -%}
                <div class="cart-item__properties">
                  <dl>
                    {%- for property in item.properties -%}
                      {%- assign property_first_char = property.first | slice: 0 -%}
                      {%- if property.last != blank and property_first_char != '_' -%}
                        <div class="property-line">
                          <dt>{{ property.first | escape }}:</dt>
                          <dd>
                            {% assign artwork_https = property.last | slice: 0, 24 %}
                            {% assign artwork_protocol_relative = property.last | slice: 0, 18 %}
                            {% if property.first == 'Artwork File' and artwork_https == 'https://cdn.shopify.com/' or property.first == 'Artwork File' and artwork_protocol_relative == '//cdn.shopify.com/' %}
                              <a href="{{ property.last | escape }}" target="_blank" rel="noopener noreferrer">View uploaded artwork</a>
                            {% else %}
                              {{ property.last | escape }}
                            {% endif %}
                          </dd>
                        </div>
                      {%- endif -%}
                    {%- endfor -%}
                  </dl>
                </div>
              {%- endif -%}
              
              <div class="cart-item__price">{{ item.final_line_price | money }}</div>
              
               {% if composition_id != blank and service_kind == blank %}
                 <a href="{{ item.product.url }}?edit={{ composition_id | url_encode }}" class="cart-item__edit">Edit design</a><br>
                 <button type="button" class="cart-item__remove" data-remove-composition="{{ composition_id | escape }}">Remove composition</button>
               {% elsif composition_id == blank %}
                 <a href="{{ item.url_to_remove }}" class="cart-item__remove">Remove</a>
               {% endif %}
            </div>
            <div class="cart-item__totals">
              <div class="quantity">
                 <button class="quantity__button" name="minus" type="button" aria-label="Decrease quantity of {{ item.product.title | escape }}">&minus;</button>
                 <input class="quantity__input" type="number" name="updates[]" value="{{ item.quantity }}" min="0" {% if composition_id != blank %}readonly{% endif %} aria-label="Quantity of {{ item.product.title | escape }}">
                 <button class="quantity__button" name="plus" type="button" aria-label="Increase quantity of {{ item.product.title | escape }}">+</button>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
      
       <p class="cart-noscript">JavaScript is required to safely validate grouped composition services before checkout. Your variant selections remain visible above.</p>
       <div class="cart-footer">
        <div class="cart-subtotal">
          <span>Estimated Total</span>
          <span>{{ cart.total_price | money }}</span>
        </div>
         <p class="cart-note">Your display and selected services are shown separately. To refine the design, select “Edit design” above. Your preferred week is subject to confirmation; taxes and delivery details are calculated at checkout.</p>
        <div class="cart-buttons">
          <button type="submit" name="update" class="button button--secondary">Update selection</button>
          <button type="submit" name="checkout" class="button button--accent">Proceed to checkout</button>
        </div>
      </div>
    </form>
  {% else %}
    <div class="cart-empty">
      <span class="eyebrow">A beginning</span>
      <h2>Your design begins here.</h2>
      <p>Explore our considered displays and create a welcome of your own.</p>
      <a href="{{ routes.root_url }}" class="button button--accent">Explore the collection</a>
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Cart",
  "settings": []
}
{% endschema %}
<style>
.studio-about { padding: var(--spacing-xl) 0; }
.studio-about__header { max-width: 820px; margin: 0 auto var(--spacing-lg); text-align: center; }
.studio-about__header h1 { margin-bottom: var(--spacing-sm); font-size: 3.5rem; }
.studio-about__header > p { color: var(--color-muted); line-height: 1.7; }
.studio-about__layout { display: grid; grid-template-columns: 1fr 1fr; gap: var(--spacing-lg); align-items: center; }
.studio-about__copy h2 { font-size: 2rem; }
.studio-about__copy p { color: var(--color-muted); line-height: 1.8; }
.studio-about__image { border: 1px solid var(--color-border); box-shadow: var(--shadow-card); }
.studio-about__image img { display: block; width: 100%; height: auto; }
@media (max-width: 900px) { .studio-about__layout { grid-template-columns: 1fr; } }
</style>

<section class="studio-about container">
  <header class="studio-about__header">
    <div class="eyebrow">{{ section.settings.eyebrow | escape }}</div>
    <h1>{{ section.settings.title | escape }}</h1>
    <p>{{ section.settings.intro | escape }}</p>
  </header>
  <div class="studio-about__layout">
    <div class="studio-about__copy">
      <h2>{{ section.settings.subheading | escape }}</h2>
      <p>{{ section.settings.body_one | escape }}</p>
      <p>{{ section.settings.body_two | escape }}</p>
    </div>
    <div class="studio-about__image">
      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', alt: section.settings.image.alt, widths: '400, 700, 1000', sizes: '(max-width: 900px) 100vw, 50vw' }}
      {% else %}
        <img src="{{ 'package-large.webp' | asset_url }}" width="1800" height="1200" alt="A large-scale seasonal entry display" loading="lazy">
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Studio introduction",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "The Studio"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Architectural styling for the season."
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Introduction",
      "default": "We look at the doorway as part of the whole home. A seasonal display should feel considered in its colors, proportions, and placement."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Section heading",
      "default": "Thoughtful from the threshold out."
    },
    {
      "type": "textarea",
      "id": "body_one",
      "label": "First paragraph",
      "default": "Height matters on a broad stair. A narrow stoop needs room to breathe. For a storefront, the display should welcome people without hiding the entrance. These are the practical details behind an intentional composition."
    },
    {
      "type": "textarea",
      "id": "body_two",
      "label": "Second paragraph",
      "default": "Begin with the scale of your space, then choose a color story. Notes in your brief are the place to describe the architecture, an event date, or a particular detail you would like considered. Individual pumpkins and gourds may vary with the harvest."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Studio image"
    }
  ],
  "presets": [
    {
      "name": "Studio introduction"
    }
  ]
}
{% endschema %}
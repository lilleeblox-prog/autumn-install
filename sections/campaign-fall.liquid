{%- comment -%} Fall ordering page — editorial stacked layout {%- endcomment -%}

<!-- ── PAGE HEADER ── -->
<header class="mtw-fp__header">
  <div class="mtw-container mtw-fp__header-inner">
    <span class="mtw-mono mtw-eyebrow mtw-eyebrow--primary">{{ section.settings.eyebrow | default: 'Hello Harvest · Fall 2026 · Tennessee' }}</span>
    <h1 class="mtw-fp__title">{{ section.settings.headline | default: 'Fall packages.' }}</h1>
    <p class="mtw-fp__intro">{{ section.settings.intro | default: 'Every display is delivered and installed by hand. Choose your size, select your week, and we handle the rest.' }}</p>
    <div class="mtw-fp__header-meta">
      <span class="mtw-fp__meta-pill">
        <svg width="10" height="10" viewBox="0 0 10 10" fill="currentColor"><circle cx="5" cy="5" r="5"/></svg>
        {{ section.settings.status_text | default: 'Ordering open' }}
      </span>
      <span class="mtw-fp__meta-divider">·</span>
      <span>{{ section.settings.meta_weeks | default: 'Install weeks: Sept – Oct 2026' }}</span>
    </div>
  </div>
</header>

<!-- ── LIGHTWEIGHT COUNTDOWN ── -->
<div class="mtw-fp__countdown-strip">
  <div class="mtw-container">
    <div class="mtw-fp__countdown-inner">
      <span class="mtw-mono mtw-fp__countdown-label">{{ section.settings.countdown_label | default: 'Days until Halloween' }}</span>
      <div class="mtw-fp__countdown-digits" id="mtw-fp-clock">
        <span class="mtw-fp__countdown-unit"><span class="mtw-fp__countdown-num" id="fpc-d">--</span><span class="mtw-fp__countdown-sub">d</span></span>
        <span class="mtw-fp__countdown-sep">:</span>
        <span class="mtw-fp__countdown-unit"><span class="mtw-fp__countdown-num" id="fpc-h">--</span><span class="mtw-fp__countdown-sub">h</span></span>
        <span class="mtw-fp__countdown-sep">:</span>
        <span class="mtw-fp__countdown-unit"><span class="mtw-fp__countdown-num" id="fpc-m">--</span><span class="mtw-fp__countdown-sub">m</span></span>
        <span class="mtw-fp__countdown-sep">:</span>
        <span class="mtw-fp__countdown-unit"><span class="mtw-fp__countdown-num" id="fpc-s">--</span><span class="mtw-fp__countdown-sub">s</span></span>
      </div>
    </div>
  </div>
</div>

<!-- ── HOW IT WORKS ── -->
{%- assign has_steps = false -%}
{%- for block in section.blocks -%}{%- if block.type == 'step' -%}{%- assign has_steps = true -%}{%- break -%}{%- endif -%}{%- endfor -%}

{%- if has_steps -%}
<section class="mtw-fp__hiw">
  <div class="mtw-container">
    <div class="mtw-fp__hiw-hd">
      <span class="mtw-mono mtw-eyebrow mtw-eyebrow--muted">{{ section.settings.hiw_eyebrow | default: 'Simple process' }}</span>
      <h2 class="mtw-h2">{{ section.settings.hiw_headline | default: 'How it works.' }}</h2>
    </div>
    <ol class="mtw-fp__hiw-list">
      {%- assign step_num = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'step' -%}
          {%- assign step_num = step_num | plus: 1 -%}
          <li {{ block.shopify_attributes }}>
            <span class="mtw-mono mtw-fp__hiw-num">{{ step_num | prepend: '0' | slice: -2, 2 }}</span>
            <div>
              <h4>{{ block.settings.title }}</h4>
              {%- if block.settings.desc != blank -%}
                <p>{{ block.settings.desc }}</p>
              {%- endif -%}
            </div>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ol>
  </div>
</section>
{%- endif -%}

<!-- ── PACKAGES ── -->
{%- assign has_packages = false -%}
{%- for block in section.blocks -%}{%- if block.type == 'package' -%}{%- assign has_packages = true -%}{%- break -%}{%- endif -%}{%- endfor -%}

{%- if has_packages -%}
<section class="mtw-fp__packages">

  {%- for block in section.blocks -%}
    {%- if block.type == 'package' -%}
      {%- assign pkg_handle   = block.settings.handle -%}
      {%- assign pkg_label    = block.settings.label -%}
      {%- assign pkg_name     = block.settings.name -%}
      {%- assign pkg_price    = block.settings.price -%}
      {%- assign pkg_desc     = block.settings.desc -%}
      {%- assign pkg_image    = block.settings.image -%}
      {%- assign pkg_featured = block.settings.featured -%}
      {%- assign pkg_cta      = block.settings.cta_label | default: 'Customize this package' -%}
      {%- assign pkg_url      = block.settings.cta_url -%}
      {%- if pkg_url == blank -%}
        {%- assign pkg_url = '/products/' | append: pkg_handle -%}
      {%- endif -%}
      {%- assign addon_lines  = block.settings.addons | newline_to_br | split: '<br />' -%}

      <div class="mtw-fp__pkg" id="pkg-{{ block.id }}" {{ block.shopify_attributes }}>
        <div class="mtw-container mtw-fp__pkg-row">

          <!-- Image -->
          <div class="mtw-fp__pkg-img-wrap">
            {%- if pkg_image != blank -%}
              <img src="{{ pkg_image | img_url: '900x' }}" alt="{{ pkg_name }}" class="mtw-fp__pkg-img" loading="lazy">
            {%- else -%}
              <div class="mtw-fp__pkg-img-placeholder">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" opacity="0.3"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
              </div>
            {%- endif -%}
          </div>

          <!-- Details -->
          <div class="mtw-fp__pkg-details">
            {%- if pkg_label != blank -%}
              <p class="mtw-mono mtw-fp__pkg-eyebrow">{{ pkg_label }}</p>
            {%- endif -%}

            <h2 class="mtw-fp__pkg-name">
              {{ pkg_name }}
              {%- if pkg_featured -%}
                <span class="mtw-fp__popular-badge">Most popular</span>
              {%- endif -%}
            </h2>

            <p class="mtw-fp__pkg-price">{{ pkg_price }}</p>

            {%- if pkg_desc != blank -%}
              <p class="mtw-fp__pkg-desc">{{ pkg_desc }}</p>
            {%- endif -%}

            <!-- Inclusions -->
            {%- assign incl_raw = block.settings.inclusions -%}
            {%- if incl_raw != blank -%}
              <div class="mtw-fp__pkg-incl">
                <p class="mtw-mono mtw-fp__pkg-incl-label">What's included</p>
                <ul class="mtw-fp__pkg-incl-list">
                  {%- assign incl_lines = incl_raw | newline_to_br | split: '<br />' -%}
                  {%- for line in incl_lines -%}
                    {%- assign l = line | strip -%}
                    {%- if l != blank -%}<li>{{ l }}</li>{%- endif -%}
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}

            <!-- Optional customizations note -->
            {%- assign addon_name_list = '' -%}
            {%- for al in addon_lines -%}
              {%- assign al_clean = al | strip -%}
              {%- if al_clean != blank -%}
                {%- assign al_parts = al_clean | split: '|' -%}
                {%- assign al_name = al_parts[0] | strip -%}
                {%- if addon_name_list == '' -%}
                  {%- assign addon_name_list = al_name -%}
                {%- else -%}
                  {%- assign addon_name_list = addon_name_list | append: ', ' | append: al_name -%}
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
            {%- if addon_name_list != blank -%}
              <p class="mtw-fp__pkg-addon-note">
                <span class="mtw-mono">Optional customizations: </span>{{ addon_name_list }}
              </p>
            {%- endif -%}

            <!-- CTA → product page -->
            <a href="{{ pkg_url }}" class="mtw-fp__book-btn">
              <span class="mtw-fp__book-btn-text">{{ pkg_cta }}</span>
              <span class="mtw-fp__book-btn-arrow">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </a>
          </div>

        </div>
      </div>

    {%- endif -%}
  {%- endfor -%}

  <div class="mtw-container">
    <div class="mtw-fp__photo-nudge">
      <div class="mtw-fp__nudge-copy">
        <p class="mtw-fp__nudge-headline">{{ section.settings.photo_nudge | default: 'Not sure which package fits your entry?' }}</p>
        <p class="mtw-fp__nudge-sub">{{ section.settings.photo_nudge_sub | default: 'Send our design team a note and we will point you to the best fit.' }}</p>
      </div>
      <div class="mtw-fp__nudge-form-wrap">
        {%- if section.settings.form_sent == true or request.path contains 'contact' -%}
        {%- endif -%}
        {% form 'contact', class: 'mtw-fp__nudge-form' %}
          {%- if form.posted_successfully? -%}
            <p class="mtw-fp__nudge-success">✓ &nbsp;{{ section.settings.form_success | default: "Got it — we'll be in touch." }}</p>
          {%- else -%}
            <div class="mtw-fp__nudge-row">
              <input type="text" name="contact[name]" placeholder="{{ section.settings.form_name_label | default: 'Your name' }}" class="mtw-fp__nudge-input" required>
              <input type="email" name="contact[email]" placeholder="{{ section.settings.form_email_label | default: 'Email address' }}" class="mtw-fp__nudge-input" required>
            </div>
            <input type="hidden" name="contact[subject]" value="Package recommendation request">
            <textarea name="contact[body]" placeholder="{{ section.settings.form_msg_label | default: 'Tell us about your entry — size, style, any questions' }}" class="mtw-fp__nudge-textarea" rows="2"></textarea>
            <button type="submit" class="mtw-fp__nudge-submit">
              {{ section.settings.photo_nudge_link | default: 'Send us a note' }}
              <svg width="12" height="12" viewBox="0 0 14 14" fill="none" style="margin-left:0.4rem"><path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          {%- endif -%}
        {% endform %}
      </div>
    </div>
  </div>

</section>
{%- endif -%}

<!-- ── FAQ ── -->
{%- assign has_faqs = false -%}
{%- for block in section.blocks -%}{%- if block.type == 'faq-item' -%}{%- assign has_faqs = true -%}{%- break -%}{%- endif -%}{%- endfor -%}

{%- if has_faqs -%}
<section class="mtw-fp__faq">
  <div class="mtw-container mtw-fp__faq-inner">
    <div class="mtw-fp__faq-hd">
      <span class="mtw-mono mtw-eyebrow mtw-eyebrow--muted">{{ section.settings.faq_eyebrow | default: 'Questions' }}</span>
      <h2 class="mtw-h2">{{ section.settings.faq_headline | default: 'Common questions.' }}</h2>
    </div>
    <div class="mtw-fp__faq-list">
      {%- for block in section.blocks -%}
        {%- if block.type == 'faq-item' -%}
          <details class="mtw-fp__faq-item" {{ block.shopify_attributes }}>
            <summary class="mtw-fp__faq-q">{{ block.settings.question }}<span class="mtw-fp__faq-chevron">&#x276F;</span></summary>
            <p class="mtw-fp__faq-a">{{ block.settings.answer }}</p>
          </details>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

<!-- ── FINAL CTA ── -->
<section class="mtw-fp__final">
  <div class="mtw-container mtw-fp__final-inner mtw-fp__final-inner--simple">
    <span class="mtw-mono mtw-eyebrow mtw-eyebrow--primary" style="display:block;margin-bottom:0.75rem">{{ section.settings.final_eyebrow | default: 'Fall 2026 · Limited install weeks' }}</span>
    <h2 class="mtw-fp__final-h2">{{ section.settings.final_headline | default: "Don't miss your window." }}</h2>
    <p class="mtw-fp__final-body">{{ section.settings.final_body | default: 'Install weeks fill up fast. Secure your display now — we handle everything.' }}</p>
    {%- assign final_url = section.settings.final_cta_url | default: '#' -%}
    <a href="{{ final_url }}" class="mtw-btn mtw-btn--primary mtw-btn--lg" style="margin-top:2rem">
      {{ section.settings.final_cta | default: 'See packages' }}
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" style="margin-left:0.5rem"><path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </a>
  </div>
</section>

<script>
(function(){
  var t = new Date('October 31, 2026 23:59:59').getTime();
  function pad(n){ return String(n).padStart(2,'0'); }
  function tick(){
    var diff = t - Date.now();
    if(diff <= 0){
      var el = document.getElementById('mtw-fp-clock');
      if(el) el.innerHTML = '<p style="font-family:var(--mtw-font-mono);font-size:0.85rem;color:var(--mtw-primary)">Season complete.</p>';
      return;
    }
    var d=document.getElementById('fpc-d'), h=document.getElementById('fpc-h'),
        m=document.getElementById('fpc-m'), s=document.getElementById('fpc-s');
    if(d) d.textContent = pad(Math.floor(diff/86400000));
    if(h) h.textContent = pad(Math.floor((diff%86400000)/3600000));
    if(m) m.textContent = pad(Math.floor((diff%3600000)/60000));
    if(s) s.textContent = pad(Math.floor((diff%60000)/1000));
  }
  tick(); setInterval(tick,1000);
})();
</script>

{% schema %}
{
  "name": "Campaign — Fall",
  "settings": [
    { "type": "header", "content": "Page header" },
    { "type": "text",     "id": "eyebrow",         "label": "Eyebrow",             "default": "Hello Harvest · Fall 2026 · Tennessee" },
    { "type": "text",     "id": "headline",         "label": "Headline",            "default": "Fall packages." },
    { "type": "textarea", "id": "intro",            "label": "Intro text",          "default": "Every display is delivered and installed by hand. Choose your size, select your week, and we handle the rest." },
    { "type": "text",     "id": "status_text",      "label": "Status pill text",    "default": "Ordering open" },
    { "type": "text",     "id": "meta_weeks",       "label": "Install weeks blurb", "default": "Install weeks: Sept – Oct 2026" },
    { "type": "text",     "id": "countdown_label",  "label": "Countdown label",     "default": "Days until Halloween" },
    { "type": "header", "content": "Package section footer" },
    { "type": "text",     "id": "photo_nudge",        "label": "Nudge headline",        "default": "Not sure which package fits your entry?" },
    { "type": "text",     "id": "photo_nudge_sub",    "label": "Nudge sub-copy",        "default": "Send our design team a note and we will point you to the best fit." },
    { "type": "text",     "id": "photo_nudge_link",   "label": "Submit button label",   "default": "Send us a note" },
    { "type": "text",     "id": "form_name_label",    "label": "Name placeholder",      "default": "Your name" },
    { "type": "text",     "id": "form_email_label",   "label": "Email placeholder",     "default": "Email address" },
    { "type": "text",     "id": "form_msg_label",     "label": "Message placeholder",   "default": "Tell us about your entry — size, style, any questions" },
    { "type": "text",     "id": "form_success",       "label": "Success message",       "default": "Got it — we'll be in touch." },
    { "type": "header", "content": "How it works section" },
    { "type": "text",     "id": "hiw_eyebrow",      "label": "Eyebrow",             "default": "Simple process" },
    { "type": "text",     "id": "hiw_headline",     "label": "Headline",            "default": "How it works." },
    { "type": "header", "content": "FAQ section" },
    { "type": "text",     "id": "faq_eyebrow",      "label": "Eyebrow",             "default": "Questions" },
    { "type": "text",     "id": "faq_headline",     "label": "Headline",            "default": "Common questions." },
    { "type": "header", "content": "Final CTA section" },
    { "type": "text",     "id": "final_eyebrow",    "label": "Eyebrow",             "default": "Fall 2026 · Limited install weeks" },
    { "type": "text",     "id": "final_headline",   "label": "Headline",            "default": "Don't miss your window." },
    { "type": "textarea", "id": "final_body",       "label": "Body",                "default": "Install weeks fill up fast. Secure your display now — we handle everything." },
    { "type": "text",     "id": "final_cta",        "label": "Button label",        "default": "See packages" },
    { "type": "text",     "id": "final_cta_url",    "label": "Button URL",          "default": "#" }
  ],
  "blocks": [
    {
      "type": "package",
      "name": "Package",
      "settings": [
        { "type": "image_picker", "id": "image",      "label": "Photo" },
        { "type": "text",         "id": "label",      "label": "Eyebrow label",                   "default": "Perfect for a stoop" },
        { "type": "text",         "id": "name",       "label": "Package name",                    "default": "Package Name" },
        { "type": "text",         "id": "price",      "label": "Display price",                   "default": "$385" },
        { "type": "textarea",     "id": "desc",       "label": "Description" },
        { "type": "textarea",     "id": "inclusions", "label": "What's included (one item per line)" },
        { "type": "textarea",     "id": "addons",     "label": "Optional customizations (one per line: Name|+price)", "info": "Example: Hay Bale|+40" },
        { "type": "checkbox",     "id": "featured",   "label": "Show \"Most popular\" badge",      "default": false },
        { "type": "text",         "id": "cta_label",  "label": "Button label",                    "default": "Customize this package" },
        { "type": "text",         "id": "cta_url",    "label": "Button URL (leave blank to auto-link to product handle)" },
        { "type": "text",         "id": "handle",     "label": "Product handle (for auto URL)",    "default": "petite-patch" }
      ]
    },
    {
      "type": "step",
      "name": "How it works — step",
      "settings": [
        { "type": "text",     "id": "title", "label": "Step title",       "default": "Step title" },
        { "type": "textarea", "id": "desc",  "label": "Step description", "default": "Step description" }

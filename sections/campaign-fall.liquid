      </a>
      <span class="mtw-campaign-hero__note">{{ section.settings.hero_note | default: 'Delivery & installation included in every package' }}</span>
    </div>
  </div>
</section>

<!-- ── VALUE PILLS ── -->
<section class="mtw-campaign-pills">

<!-- ── HOW IT WORKS ── -->
<section class="mtw-campaign-hiw">
  <div class="mtw-container">
    <div class="mtw-campaign-section-hd">
      <span class="mtw-mono mtw-eyebrow mtw-eyebrow--muted">Simple process</span>
      <h2 class="mtw-h2">How it works.</h2>
    </div>
    <div class="mtw-campaign-hiw__grid">
      <div class="mtw-campaign-hiw__step">
        <span class="mtw-campaign-hiw__num">01</span>
        <h3 class="mtw-campaign-hiw__title">Choose your package</h3>
        <p>Pick from four sizes — Petite Patch through Grande Harvest. Add hay bales, custom design, or end-of-season removal at checkout.</p>
      </div>
      <div class="mtw-campaign-hiw__step">
        <span class="mtw-campaign-hiw__num">02</span>
        <h3 class="mtw-campaign-hiw__title">Select your install week</h3>
        <p>Choose the week that works for you — September through late October. We confirm your exact day and arrival window after your order.</p>
      </div>
      <div class="mtw-campaign-hiw__step">
        <span class="mtw-campaign-hiw__num">03</span>
        <h3 class="mtw-campaign-hiw__title">We arrive and style</h3>
        <p>Our team brings everything and arranges your display by hand. No heavy lifting, no coordination — just open your door to a finished entry.</p>
      </div>
      <div class="mtw-campaign-hiw__step">
        <span class="mtw-campaign-hiw__num">04</span>
        <h3 class="mtw-campaign-hiw__title">Optional removal</h3>
        <p>Add removal at checkout and we'll come back after Halloween to clear everything away. Nothing left on your to-do list.</p>
      </div>
    </div>
  </div>
</section>


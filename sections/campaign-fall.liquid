<!-- ── FAQ ── -->
<section class="mtw-campaign-faq">
  <div class="mtw-container mtw-campaign-faq__inner">
    <div class="mtw-campaign-section-hd" style="text-align:left;margin-bottom:2.5rem">
      <span class="mtw-mono mtw-eyebrow mtw-eyebrow--muted">Common questions</span>
      <h2 class="mtw-h2">Everything you need to know.</h2>
    </div>

    <div class="mtw-campaign-faq__list">
      {%- assign faqs = "What area do you serve?|We currently serve Nashville, TN and surrounding areas. Exact service boundaries are checked at checkout — enter your zip and we'll confirm availability.;When do installs happen?|We install September through late October. At checkout you'll pick your install week. We'll follow up to confirm your exact date and a morning or afternoon arrival window.;What if I'm not home?|No problem — just let us know your preferred placement and any gate codes in your order notes. We'll style the display and send you a photo when we're done.;Do I need to provide anything?|Nothing. We bring all pumpkins, gourds, hay bales, and any other items in your package. Just tell us where you'd like the display.;Can I add removal later?|Removal is easiest to add at checkout, but reach out to hello@madetowelcome.com before October 15th and we'll add it for you.;What if something breaks or looks wrong?|We stand behind our work. If something isn't right, email us a photo and we'll make it right — simple as that." | split: ";" -%}

      {%- for faq in faqs -%}
        {%- assign parts = faq | split: "|" -%}
        <details class="mtw-campaign-faq__item">
          <summary class="mtw-campaign-faq__q">{{ parts[0] }}<span class="mtw-campaign-faq__chevron">&#x276F;</span></summary>
          <p class="mtw-campaign-faq__a">{{ parts[1] }}</p>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

<!-- ── FINAL CTA + COUNTDOWN ── -->
<section class="mtw-campaign-final">
  <div class="mtw-container mtw-campaign-final__inner">
    <div class="mtw-campaign-final__copy">
      <span class="mtw-mono mtw-eyebrow mtw-eyebrow--primary">{{ section.settings.final_eyebrow | default: 'Fall 2026 · Limited install weeks' }}</span>
      <h2 class="mtw-campaign-final__h2">{{ section.settings.final_headline | default: "Don't miss your window." }}</h2>
      <p>{{ section.settings.final_body | default: 'Install weeks fill up fast. Secure your spot now — we handle everything from delivery to styling.' }}</p>
      <a href="#packages" class="mtw-btn mtw-btn--primary mtw-btn--lg" style="margin-top:2rem">
        {{ section.settings.final_cta | default: 'Book your display' }}
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" style="margin-left:0.5rem"><path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>
    <div class="mtw-campaign-final__clock">
      <p class="mtw-mono" style="font-size:0.7rem;letter-spacing:0.1em;opacity:0.5;margin-bottom:1.5rem">UNTIL HALLOWEEN</p>
      <div class="mtw-campaign-final__digits" id="mtw-campaign-clock">
        <div class="mtw-campaign-final__unit"><span class="mtw-campaign-final__num" id="cfc-d">--</span><span class="mtw-campaign-final__lbl">Days</span></div>
        <div class="mtw-campaign-final__sep">:</div>
        <div class="mtw-campaign-final__unit"><span class="mtw-campaign-final__num" id="cfc-h">--</span><span class="mtw-campaign-final__lbl">Hrs</span></div>
        <div class="mtw-campaign-final__sep">:</div>
        <div class="mtw-campaign-final__unit"><span class="mtw-campaign-final__num" id="cfc-m">--</span><span class="mtw-campaign-final__lbl">Min</span></div>
        <div class="mtw-campaign-final__sep">:</div>
        <div class="mtw-campaign-final__unit"><span class="mtw-campaign-final__num" id="cfc-s">--</span><span class="mtw-campaign-final__lbl">Sec</span></div>
      </div>
    </div>
  </div>
</section>

<script>
(function(){
  var t = new Date('October 31, 2026 23:59:59').getTime();
  function pad(n){ return String(n).padStart(2,'0'); }
  function tick(){
    var diff = t - Date.now();
    if(diff <= 0){ var el=document.getElementById('mtw-campaign-clock'); if(el) el.innerHTML='<p style="color:var(--mtw-primary);font-family:var(--mtw-font-mono)">Season complete.</p>'; return; }
    var d=document.getElementById('cfc-d'), h=document.getElementById('cfc-h'), m=document.getElementById('cfc-m'), s=document.getElementById('cfc-s');
    if(d) d.textContent=pad(Math.floor(diff/86400000));
    if(h) h.textContent=pad(Math.floor((diff%86400000)/3600000));
    if(m) m.textContent=pad(Math.floor((diff%3600000)/60000));
    if(s) s.textContent=pad(Math.floor((diff%60000)/1000));
  }
  tick(); setInterval(tick,1000);
  /* FAQ chevron rotation */
  document.querySelectorAll('.mtw-campaign-faq__item').forEach(function(el){
    el.addEventListener('toggle',function(){ });
  });
})();
</script>


{%- comment -%} Fall ordering page — editorial stacked layout {%- endcomment -%}

{%- assign weeks_raw = section.settings.install_weeks -%}
{%- assign weeks = weeks_raw | newline_to_br | split: '<br />' -%}

{%- assign _h1 = section.settings.pkg1_handle | default: 'petite-patch' -%}
{%- assign _h2 = section.settings.pkg2_handle | default: 'cozy-corner' -%}
{%- assign _h3 = section.settings.pkg3_handle | default: 'fall-favorites' -%}
{%- assign _h4 = section.settings.pkg4_handle | default: 'grande-harvest' -%}
{%- assign p1 = all_products[_h1] -%}
{%- assign p2 = all_products[_h2] -%}
{%- assign p3 = all_products[_h3] -%}
{%- assign p4 = all_products[_h4] -%}

<!-- ── PAGE HEADER ── -->
<header class="mtw-fp__header">
  <div class="mtw-container mtw-fp__header-inner">
    <span class="mtw-mono mtw-eyebrow mtw-eyebrow--primary">{{ section.settings.eyebrow | default: 'Hello Harvest · Fall 2026 · Tennessee' }}</span>
    <h1 class="mtw-fp__title">{{ section.settings.headline | default: 'Fall packages.' }}</h1>
    <p class="mtw-fp__intro">{{ section.settings.intro | default: 'Every display is delivered and installed by hand. Choose your size, select your week, and we handle the rest.' }}</p>
    <div class="mtw-fp__header-meta">
      <span class="mtw-fp__meta-pill">
        <svg width="10" height="10" viewBox="0 0 10 10" fill="currentColor"><circle cx="5" cy="5" r="5"/></svg>
        Ordering open
      </span>
      <span class="mtw-fp__meta-divider">·</span>
      <span>Install weeks: Sept – Oct 2026</span>
      <span class="mtw-fp__meta-divider">·</span>
      <span>Delivery &amp; installation included</span>
    </div>
  </div>
</header>

<!-- ── PACKAGES ── -->
<section class="mtw-fp__packages">

  {%- assign packages = 'p1,p2,p3,p4' | split: ',' -%}
  {%- for pkg_key in packages -%}

    {%- if pkg_key == 'p1' -%}
      {%- assign pkg_product  = p1 -%}
      {%- assign pkg_handle   = section.settings.pkg1_handle  | default: 'petite-patch' -%}
      {%- assign pkg_label    = section.settings.pkg1_label   | default: 'Perfect for a stoop' -%}
      {%- assign pkg_name     = section.settings.pkg1_name    | default: 'Petite Patch' -%}
      {%- assign pkg_price    = section.settings.pkg1_price   | default: '$385' -%}
      {%- assign pkg_desc     = section.settings.pkg1_desc    | default: 'A curated mix of pumpkins and gourds, hand-arranged on delivery day. Ideal for a single-door entry or welcoming front stoop.' -%}
      {%- assign pkg_included = 'petite-patch' -%}
      {%- assign pkg_addons   = 'Hay Bale — $40|Custom Design — $75|Removal — $75' -%}
      {%- assign pkg_image    = section.settings.pkg1_image -%}
      {%- assign pkg_featured = false -%}
    {%- elsif pkg_key == 'p2' -%}
      {%- assign pkg_product  = p2 -%}
      {%- assign pkg_handle   = section.settings.pkg2_handle  | default: 'cozy-corner' -%}
      {%- assign pkg_label    = section.settings.pkg2_label   | default: 'Great for porches' -%}
      {%- assign pkg_name     = section.settings.pkg2_name    | default: 'Cozy Corner' -%}
      {%- assign pkg_price    = section.settings.pkg2_price   | default: '$585' -%}
      {%- assign pkg_desc     = section.settings.pkg2_desc    | default: 'A fuller display for a porch or covered entry. More pumpkins, more gourds, same careful arrangement by hand.' -%}
      {%- assign pkg_included = 'cozy-corner' -%}
      {%- assign pkg_addons   = 'Hay Bale — $40|Custom Design — $100|Removal — $100' -%}
      {%- assign pkg_image    = section.settings.pkg2_image -%}
      {%- assign pkg_featured = false -%}
    {%- elsif pkg_key == 'p3' -%}
      {%- assign pkg_product  = p3 -%}
      {%- assign pkg_handle   = section.settings.pkg3_handle  | default: 'fall-favorites' -%}
      {%- assign pkg_label    = section.settings.pkg3_label   | default: 'Most popular' -%}
      {%- assign pkg_name     = section.settings.pkg3_name    | default: 'Fall Favorites' -%}
      {%- assign pkg_price    = section.settings.pkg3_price   | default: '$885' -%}
      {%- assign pkg_desc     = section.settings.pkg3_desc    | default: 'Our most-booked display. A generous mix of pumpkins, specialty gourds, and two hay bales — everything it takes to make a real impression at the door.' -%}
      {%- assign pkg_included = 'fall-favorites' -%}
      {%- assign pkg_addons   = 'Residential Gate Pumpkins & Design|Removal — $150' -%}
      {%- assign pkg_image    = section.settings.pkg3_image -%}
      {%- assign pkg_featured = true -%}
    {%- elsif pkg_key == 'p4' -%}
      {%- assign pkg_product  = p4 -%}
      {%- assign pkg_handle   = section.settings.pkg4_handle  | default: 'grande-harvest' -%}
      {%- assign pkg_label    = section.settings.pkg4_label   | default: 'The full treatment' -%}
      {%- assign pkg_name     = section.settings.pkg4_name    | default: 'Grande Harvest' -%}
      {%- assign pkg_price    = section.settings.pkg4_price   | default: '$1,285' -%}
      {%- assign pkg_desc     = section.settings.pkg4_desc    | default: 'Hay bales, ornamental gourds, pie pumpkins, mini varieties — the kind of display that carries the whole season and stops everyone who passes.' -%}
      {%- assign pkg_included = 'grande-harvest' -%}
      {%- assign pkg_addons   = 'Residential Gate Pumpkins & Design|Removal — $200' -%}
      {%- assign pkg_image    = section.settings.pkg4_image -%}
      {%- assign pkg_featured = false -%}
    {%- endif -%}

    {%- assign addon_list = pkg_addons | split: '|' -%}
    {%- assign vid = pkg_product.variants.first.id -%}

    <div class="mtw-fp__pkg {% if pkg_featured %}mtw-fp__pkg--featured{% endif %}" id="pkg-{{ pkg_key }}">

      {%- if pkg_featured -%}
        <div class="mtw-fp__featured-banner">
          <div class="mtw-container">
            <span class="mtw-mono">Most Popular</span>
          </div>
        </div>
      {%- endif -%}

      <div class="mtw-container mtw-fp__pkg-row">

        <!-- Image -->
        <div class="mtw-fp__pkg-img-wrap">
          {%- if pkg_image != blank -%}
            <img src="{{ pkg_image | img_url: '900x' }}" alt="{{ pkg_name }}" class="mtw-fp__pkg-img" loading="lazy">
          {%- else -%}
            <div class="mtw-fp__pkg-img-placeholder">
              <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" opacity="0.3"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
            </div>
          {%- endif -%}
        </div>

        <!-- Details -->
        <div class="mtw-fp__pkg-details">
          <p class="mtw-mono mtw-fp__pkg-eyebrow">Made to Welcome</p>
          <h2 class="mtw-fp__pkg-name">{{ pkg_name }}</h2>
          <p class="mtw-fp__pkg-price">{{ pkg_price }}</p>
          <p class="mtw-fp__pkg-desc">{{ pkg_desc }}</p>

          <!-- Inclusions -->
          <div class="mtw-fp__pkg-incl">
            <p class="mtw-mono mtw-fp__pkg-incl-label">What's included</p>
            <ul class="mtw-fp__pkg-incl-list">
              {%- if pkg_included == 'petite-patch' -%}
                <li>4 Large Jack O'Lantern Pumpkins</li>
                <li>4 Medium Jack O'Lantern Pumpkins</li>
                <li>4 White Ghost Pumpkins</li>
                <li>6 Specialty Pumpkins</li>
                <li>Assortment of Pie Pumpkins</li>
              {%- elsif pkg_included == 'cozy-corner' -%}
                <li>6 Large Jack O'Lantern Pumpkins</li>
                <li>6 Medium Jack O'Lantern Pumpkins</li>
                <li>6 White Ghost Pumpkins</li>
                <li>8 Specialty Pumpkins</li>
                <li>Assortment of Pie Pumpkins</li>
              {%- elsif pkg_included == 'fall-favorites' -%}
                <li>8 Large Jack O'Lantern Pumpkins</li>
                <li>8 Medium Jack O'Lantern Pumpkins</li>
                <li>8 White Ghost Pumpkins</li>
                <li>14 Specialty Pumpkins</li>
                <li>2 Hay Bales <em>(included)</em></li>
                <li>Assortment of Pie Pumpkins</li>
              {%- elsif pkg_included == 'grande-harvest' -%}
                <li>10 Large Jack O'Lantern Pumpkins</li>
                <li>8 Medium Jack O'Lantern Pumpkins</li>
                <li>8 White Ghost Pumpkins</li>
                <li>16 Specialty Pumpkins</li>
                <li>2 Hay Bales <em>(included)</em></li>
                <li>Mini White &amp; Mini Orange Pumpkins</li>
                <li>Ornamental Gourds</li>
                <li>Assortment of Pie Pumpkins</li>
              {%- endif -%}
            </ul>
          </div>

          <!-- Add-ons note -->
          <p class="mtw-fp__pkg-addon-note">
            <span class="mtw-mono">Add-ons available: </span>
            {{ addon_list | join: ' · ' }}
          </p>

          <!-- Book button -->
          <button
            class="mtw-fp__book-btn"
            data-target="mtw-form-{{ pkg_key }}"
            aria-expanded="false"
            aria-controls="mtw-form-{{ pkg_key }}"
          >
            <span class="mtw-fp__book-btn-text">Book {{ pkg_name }}</span>
            <span class="mtw-fp__book-btn-arrow">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M8 3v10M3 8l5 5 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </button>
        </div>
      </div>

      <!-- ── Inline order form ── -->
      <div class="mtw-fp__form-wrap" id="mtw-form-{{ pkg_key }}" hidden>
        <div class="mtw-container">
          <div class="mtw-fp__form-inner">
            <h3 class="mtw-fp__form-title">Customize your order</h3>

            {%- if vid != blank and vid != 0 -%}
              <form action="/cart/add" method="POST" class="mtw-fp__form" data-pkg="{{ pkg_key }}">
                <input type="hidden" name="id" value="{{ vid }}">
                <input type="hidden" name="quantity" value="1">

                <div class="mtw-fp__form-grid">

                  <!-- Install week -->
                  <div class="mtw-fp__form-field mtw-fp__form-field--full">
                    <label class="mtw-fp__form-label" for="week-{{ pkg_key }}">Install week <span class="mtw-fp__required">*</span></label>
                    <select name="properties[Install Week]" id="week-{{ pkg_key }}" class="mtw-fp__form-select" required>
                      <option value="">Select a week —</option>
                      {%- for week in weeks -%}
                        {%- assign w = week | strip -%}
                        {%- if w != blank -%}
                          <option value="{{ w }}">{{ w }}</option>
                        {%- endif -%}
                      {%- endfor -%}
                    </select>
                  </div>

                  <!-- Zip code -->
                  <div class="mtw-fp__form-field">
                    <label class="mtw-fp__form-label" for="zip-{{ pkg_key }}">Install zip code <span class="mtw-fp__required">*</span></label>
                    <input type="text" name="properties[Install Zip]" id="zip-{{ pkg_key }}" class="mtw-fp__form-input" placeholder="e.g. 37215" inputmode="numeric" maxlength="5" required>
                  </div>

                  <!-- Add-ons -->
                  <div class="mtw-fp__form-field">
                    <p class="mtw-fp__form-label">Add-ons <span class="mtw-fp__form-optional">(optional)</span></p>
                    <div class="mtw-fp__addon-checks">
                      {%- for addon in addon_list -%}
                        <label class="mtw-fp__addon-label">
                          <input type="checkbox" name="properties[Add-on: {{ addon }}]" value="Yes" class="mtw-fp__addon-check">
                          <span>{{ addon }}</span>
                        </label>
                      {%- endfor -%}
                    </div>
                  </div>

                  <!-- Notes -->
                  <div class="mtw-fp__form-field mtw-fp__form-field--full">
                    <label class="mtw-fp__form-label" for="notes-{{ pkg_key }}">Notes for our team <span class="mtw-fp__form-optional">(optional)</span></label>
                    <textarea name="properties[Notes]" id="notes-{{ pkg_key }}" class="mtw-fp__form-textarea" rows="3" placeholder="Gate codes, placement preferences, anything else we should know…"></textarea>
                  </div>

                </div>

                <div class="mtw-fp__form-actions">
                  <button type="submit" class="mtw-btn mtw-btn--primary mtw-fp__form-submit">
                    Add to cart — {{ pkg_price }}
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none" style="margin-left:0.5rem"><path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </button>
                  <p class="mtw-fp__form-note">Delivery &amp; installation included. We'll confirm your exact date after your order.</p>
                </div>
              </form>
            {%- else -%}
              <div style="text-align:center;padding:2rem 0">
                <a href="/products/{{ pkg_handle }}" class="mtw-btn mtw-btn--primary">
                  Book {{ pkg_name }} on product page →
                </a>
              </div>
            {%- endif -%}

            <button class="mtw-fp__form-close" data-target="mtw-form-{{ pkg_key }}">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
              Close
            </button>
          </div>
        </div>
      </div>

    </div>
  {%- endfor -%}

  <div class="mtw-container">
    <p class="mtw-fp__photo-nudge">
      Not sure which package fits your entry?
      <a href="mailto:hello@madetowelcome.com?subject=Help%20me%20choose%20a%20package&body=Hi!%20I'd%20love%20a%20package%20recommendation%20-%20I'll%20attach%20a%20photo%20of%20my%20entryway.">Send us a photo →</a>
    </p>
  </div>

</section>

<!-- ── HOW IT WORKS ── -->
<section class="mtw-fp__hiw">
  <div class="mtw-container">
    <div class="mtw-fp__hiw-hd">
      <span class="mtw-mono mtw-eyebrow mtw-eyebrow--muted">Simple process</span>
      <h2 class="mtw-h2">How it works.</h2>
    </div>
    <ol class="mtw-fp__hiw-list">
      <li>
        <span class="mtw-mono mtw-fp__hiw-num">01</span>
        <div>
          <h4>Choose your package above</h4>
          <p>Pick the size that fits your entry. Add hay bales, gate design, or removal directly in the form.</p>
        </div>
      </li>
      <li>
        <span class="mtw-mono mtw-fp__hiw-num">02</span>
        <div>
          <h4>Select your install week</h4>
          <p>September through late October. We'll follow up to confirm your exact day and arrival window.</p>
        </div>
      </li>
      <li>
        <span class="mtw-mono mtw-fp__hiw-num">03</span>
        <div>
          <h4>We arrive and style</h4>
          <p>Our team brings everything and arranges your display by hand. No lifting, no coordination — just a finished entry.</p>
        </div>
      </li>
      <li>
        <span class="mtw-mono mtw-fp__hiw-num">04</span>
        <div>
          <h4>Optional removal</h4>
          <p>Add removal at checkout and we return after Halloween to clear everything. Nothing left on your list.</p>
        </div>
      </li>
    </ol>
  </div>
</section>

<!-- ── FAQ ── -->
<section class="mtw-fp__faq">
  <div class="mtw-container mtw-fp__faq-inner">
    <div class="mtw-fp__faq-hd">
      <span class="mtw-mono mtw-eyebrow mtw-eyebrow--muted">Questions</span>
      <h2 class="mtw-h2">Common questions.</h2>
    </div>
    <div class="mtw-fp__faq-list">
      {%- assign faqs = "What area do you serve?|We currently serve Nashville, TN and surrounding areas. Enter your zip in the order form and we'll confirm availability.;When do installs happen?|September through late October. You pick your week at checkout — we'll follow up with your exact date and arrival window.;What if I'm not home?|No problem. Leave placement notes and any gate codes in your order. We'll style the display and send a photo when we're done.;Do I need to provide anything?|Nothing. We bring all pumpkins, gourds, hay bales, and styling materials. Just let us know where you'd like the display.;Can I add removal later?|It's easiest at checkout, but email hello@madetowelcome.com before October 15th and we'll add it for you.;What if something doesn't look right?|We stand behind our work. Send us a photo and we'll make it right — no hassle." | split: ";" -%}
      {%- for faq in faqs -%}
        {%- assign parts = faq | split: "|" -%}
        <details class="mtw-fp__faq-item">
          <summary class="mtw-fp__faq-q">{{ parts[0] }}<span class="mtw-fp__faq-chevron">&#x276F;</span></summary>
          <p class="mtw-fp__faq-a">{{ parts[1] }}</p>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

<!-- ── COUNTDOWN + FINAL CTA ── -->
<section class="mtw-fp__final">
  <div class="mtw-container mtw-fp__final-inner">
    <div class="mtw-fp__final-copy">
      <span class="mtw-mono mtw-eyebrow mtw-eyebrow--primary" style="display:block;margin-bottom:0.75rem">{{ section.settings.final_eyebrow | default: 'Fall 2026 · Limited install weeks' }}</span>
      <h2 class="mtw-fp__final-h2">{{ section.settings.final_headline | default: "Don't miss your window." }}</h2>
      <p class="mtw-fp__final-body">{{ section.settings.final_body | default: 'Install weeks fill up fast. Secure your display now — we handle everything.' }}</p>
      <a href="#pkg-p1" class="mtw-btn mtw-btn--primary mtw-btn--lg" style="margin-top:2rem">
        {{ section.settings.final_cta | default: 'Book your display' }}
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" style="margin-left:0.5rem"><path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>
    <div class="mtw-fp__final-clock">
      <p class="mtw-mono" style="font-size:0.65rem;letter-spacing:0.12em;opacity:0.4;margin-bottom:1.25rem;text-transform:uppercase">Until Halloween</p>
      <div class="mtw-fp__clock-digits" id="mtw-fp-clock">
        <div class="mtw-fp__clock-unit"><span class="mtw-fp__clock-num" id="fpc-d">--</span><span class="mtw-fp__clock-lbl">Days</span></div>
        <span class="mtw-fp__clock-sep">:</span>
        <div class="mtw-fp__clock-unit"><span class="mtw-fp__clock-num" id="fpc-h">--</span><span class="mtw-fp__clock-lbl">Hrs</span></div>
        <span class="mtw-fp__clock-sep">:</span>
        <div class="mtw-fp__clock-unit"><span class="mtw-fp__clock-num" id="fpc-m">--</span><span class="mtw-fp__clock-lbl">Min</span></div>
        <span class="mtw-fp__clock-sep">:</span>
        <div class="mtw-fp__clock-unit"><span class="mtw-fp__clock-num" id="fpc-s">--</span><span class="mtw-fp__clock-lbl">Sec</span></div>
      </div>
    </div>
  </div>
</section>

<script>
(function(){
  /* ── Book button toggles inline form ── */
  document.querySelectorAll('.mtw-fp__book-btn').forEach(function(btn){
    btn.addEventListener('click', function(){
      var id  = btn.getAttribute('data-target');
      var wrap = document.getElementById(id);
      if(!wrap) return;
      var open = !wrap.hidden;
      wrap.hidden = open;
      btn.setAttribute('aria-expanded', String(!open));
      if(!open){
        wrap.scrollIntoView({ behavior: 'smooth', block: 'start' });
        var sel = wrap.querySelector('select');
        if(sel) sel.focus();
      }
    });
  });

  /* Close buttons */
  document.querySelectorAll('.mtw-fp__form-close').forEach(function(btn){
    btn.addEventListener('click', function(){
      var id   = btn.getAttribute('data-target');
      var wrap = document.getElementById(id);
      if(wrap){ wrap.hidden = true; }
      var bookBtn = document.querySelector('[data-target="'+id+'"].mtw-fp__book-btn');
      if(bookBtn){ bookBtn.setAttribute('aria-expanded','false'); bookBtn.focus(); }
    });
  });

  /* Add-on checkboxes → consolidate into one property string */
  document.querySelectorAll('.mtw-fp__form').forEach(function(form){
    form.addEventListener('submit', function(e){
      var checks = form.querySelectorAll('.mtw-fp__addon-check:checked');
      /* Remove individual checkbox inputs from POST, add a single combined property */
      var names = [];
      checks.forEach(function(c){ names.push(c.value ? c.closest('label').querySelector('span').textContent.trim() : ''); });
      /* Strip individual properties and replace with one */
      form.querySelectorAll('.mtw-fp__addon-check').forEach(function(c){ c.disabled = true; });
      var hidden = document.createElement('input');
      hidden.type = 'hidden';
      hidden.name = 'properties[Add-ons]';
      hidden.value = names.length ? names.join(', ') : 'None';
      form.appendChild(hidden);
    });
  });

  /* ── Halloween countdown ── */
  var t = new Date('October 31, 2026 23:59:59').getTime();
  function pad(n){ return String(n).padStart(2,'0'); }
  function tick(){
    var diff = t - Date.now();
    if(diff <= 0){
      var el = document.getElementById('mtw-fp-clock');
      if(el) el.innerHTML = '<p style="font-family:var(--mtw-font-mono);font-size:0.85rem;color:var(--mtw-primary)">Season complete.</p>';
      return;
    }
    var d=document.getElementById('fpc-d'), h=document.getElementById('fpc-h'),
        m=document.getElementById('fpc-m'), s=document.getElementById('fpc-s');
    if(d) d.textContent = pad(Math.floor(diff/86400000));
    if(h) h.textContent = pad(Math.floor((diff%86400000)/3600000));
    if(m) m.textContent = pad(Math.floor((diff%3600000)/60000));
    if(s) s.textContent = pad(Math.floor((diff%60000)/1000));
  }
  tick(); setInterval(tick,1000);
})();
</script>

{% schema %}
{
  "name": "Campaign — Fall",
  "settings": [
    { "type": "header", "content": "Page header" },
    { "type": "text",     "id": "eyebrow",   "label": "Eyebrow",   "default": "Hello Harvest · Fall 2026 · Tennessee" },
    { "type": "text",     "id": "headline",  "label": "Headline",  "default": "Fall packages." },
    { "type": "textarea", "id": "intro",     "label": "Intro",     "default": "Every display is delivered and installed by hand. Choose your size, select your week, and we handle the rest." },
    { "type": "header", "content": "Install weeks" },
    { "type": "textarea", "id": "install_weeks", "label": "Install weeks (one per line)",
      "default": "Week of September 15\nWeek of September 22\nWeek of September 29\nWeek of October 6\nWeek of October 13\nWeek of October 20\nWeek of October 27" },
    { "type": "header", "content": "Package 1 — Petite Patch" },
    { "type": "text",       "id": "pkg1_handle", "label": "Product handle", "default": "petite-patch" },
    { "type": "text",       "id": "pkg1_label",  "label": "Label",          "default": "Perfect for a stoop" },
    { "type": "text",       "id": "pkg1_name",   "label": "Name",           "default": "Petite Patch" },
    { "type": "text",       "id": "pkg1_price",  "label": "Price",          "default": "$385" },
    { "type": "textarea",   "id": "pkg1_desc",   "label": "Description" },
    { "type": "image_picker","id": "pkg1_image", "label": "Photo" },
    { "type": "header", "content": "Package 2 — Cozy Corner" },

  ],
  "presets": [
    {
      "name": "Campaign — Fall",
      "blocks": [
        { "type": "package" },
        { "type": "package" },
        { "type": "package" },
        { "type": "package" },
        { "type": "step" },
        { "type": "step" },
        { "type": "step" },
        { "type": "step" },
        { "type": "faq-item" },
        { "type": "faq-item" },
        { "type": "faq-item" }
      ]
    }
  ]
}
{% endschema %}

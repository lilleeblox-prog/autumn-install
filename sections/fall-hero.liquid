<section class="mtw-fall-hero">
  {%- if section.settings.hero_image != blank -%}
    <img
      src="{{ section.settings.hero_image | image_url: width: 1800 }}"
      alt="{{ section.settings.hero_image.alt | escape }}"
      class="mtw-fall-hero__img"
      loading="eager"
      fetchpriority="high"
    >
  {%- else -%}
    <div class="mtw-fall-hero__placeholder"></div>
  {%- endif -%}

  <div class="mtw-fall-hero__overlay"></div>

  <div class="mtw-fall-hero__content">
    <span class="mtw-mono mtw-eyebrow mtw-eyebrow--primary" style="font-size:0.68rem;letter-spacing:0.18em;margin-bottom:1.25rem;display:block">
      Fall 2026 · Tennessee · Waitlist open
    </span>
    <h1 class="mtw-fall-hero__headline">
      The season starts<br class="mtw-hidden-sm"> at your door.
    </h1>
    <p class="mtw-fall-hero__sub">
      Organic pumpkins, heirloom gourds, and hay bales, arranged at your front door so your home feels ready the moment autumn arrives. A small number of homes per neighborhood, each one done by hand.
    </p>
    <div class="mtw-fall-hero__cta-row">
      <a href="#reserve" class="mtw-btn mtw-btn--primary">
        Add your name
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" style="margin-left:0.5rem;flex-shrink:0">
          <path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
      <span class="mtw-mono" style="font-size:0.68rem;letter-spacing:0.1em;text-transform:uppercase;color:rgba(255,255,255,0.5)">
        No payment now
      </span>
    </div>
  </div>

  <div class="mtw-fall-hero__status">
    <span class="mtw-fall-hero__dot"></span>
    <span class="mtw-mono" style="font-size:0.65rem;letter-spacing:0.1em;text-transform:uppercase;color:rgba(255,255,255,0.6)">
      Ordering opens mid-August
    </span>
  </div>
</section>

{% schema %}
{
  "name": "Fall — Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image"
    }
  ],
  "presets": [
    { "name": "Fall — Hero" }
  ]
}
{% endschema %}

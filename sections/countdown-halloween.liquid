<style>
.mtw-countdown { position: relative; overflow: hidden; }

.mtw-leaves {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 0;
}
.mtw-countdown__inner { position: relative; z-index: 1; }

.mtw-leaf {
  position: absolute;
  top: -80px;
  opacity: 0;
  animation: mtw-leaf-fall linear infinite;
  will-change: transform, opacity;
}

@keyframes mtw-leaf-fall {
  0%   { transform: translateY(0) translateX(0)   rotate(0deg);   opacity: 0; }
  5%   { opacity: 0.75; }
  90%  { opacity: 0.6; }
  100% { transform: translateY(110vh) translateX(var(--sway)) rotate(var(--spin)); opacity: 0; }
}
</style>

<section class="mtw-countdown {{ section.settings.bg_style }}">
  <div class="mtw-leaves" id="mtw-leaves-{{ section.id }}" aria-hidden="true"></div>

  <div class="mtw-container mtw-countdown__inner">
    <div class="mtw-countdown__copy">
      <span class="mtw-mono mtw-eyebrow mtw-eyebrow--primary">{{ section.settings.eyebrow | default: 'Hello Harvest · Fall 2026' }}</span>
      <h2 class="mtw-countdown__headline">{{ section.settings.headline | default: 'Halloween is coming.' }}</h2>
      {%- if section.settings.subtext != blank -%}
        <p class="mtw-countdown__sub">{{ section.settings.subtext }}</p>
      {%- endif -%}
    </div>

    <div class="mtw-countdown__clock" id="mtw-clock-{{ section.id }}" aria-live="polite" aria-atomic="true">
      <div class="mtw-countdown__unit">
        <span class="mtw-countdown__num" id="cd-days-{{ section.id }}">--</span>
        <span class="mtw-countdown__label">Days</span>
      </div>
      <div class="mtw-countdown__divider">:</div>
      <div class="mtw-countdown__unit">
        <span class="mtw-countdown__num" id="cd-hrs-{{ section.id }}">--</span>
        <span class="mtw-countdown__label">Hours</span>
      </div>
      <div class="mtw-countdown__divider">:</div>
      <div class="mtw-countdown__unit">
        <span class="mtw-countdown__num" id="cd-min-{{ section.id }}">--</span>
        <span class="mtw-countdown__label">Minutes</span>
      </div>
      <div class="mtw-countdown__divider">:</div>
      <div class="mtw-countdown__unit">
        <span class="mtw-countdown__num" id="cd-sec-{{ section.id }}">--</span>
        <span class="mtw-countdown__label">Seconds</span>
      </div>
    </div>
  </div>
</section>

<script>
(function(){
  /* ── Countdown ── */
  var target = new Date('{{ section.settings.target_date | default: "October 31, 2026 23:59:59" }}').getTime();
  var sid    = '{{ section.id }}';
  function pad(n){ return String(n).padStart(2,'0'); }
  function tick(){
    var diff = target - Date.now();
    if(diff <= 0){
      var clock = document.getElementById('mtw-clock-'+sid);
      if(clock) clock.innerHTML = '<p class="mtw-countdown__done">{{ section.settings.done_text | default: "Season complete — see you next fall." }}</p>';
      return;
    }
    var d = Math.floor(diff/86400000);
    var h = Math.floor((diff%86400000)/3600000);
    var m = Math.floor((diff%3600000)/60000);
    var s = Math.floor((diff%60000)/1000);
    var el;
    el = document.getElementById('cd-days-'+sid); if(el) el.textContent = pad(d);
    el = document.getElementById('cd-hrs-'+sid);  if(el) el.textContent = pad(h);
    el = document.getElementById('cd-min-'+sid);  if(el) el.textContent = pad(m);
    el = document.getElementById('cd-sec-'+sid);  if(el) el.textContent = pad(s);
  }
  tick();
  setInterval(tick, 1000);

  /* ── Falling leaves ── */
  var container = document.getElementById('mtw-leaves-'+sid);
  if(!container) return;

  /* Classic 11-point maple leaf with stem */
  var mapleD = 'M50,5 L43,22 L28,15 L33,30 L15,27 L25,42 L7,50 L27,53 L20,70 L38,65 L35,82 L50,75 L65,82 L62,65 L80,70 L73,53 L93,50 L75,42 L85,27 L67,30 L72,15 L57,22 Z M48,75 L46,110 L54,110 L52,75 Z';
  var shapes = [mapleD];

  var colors = ['#C45C1A','#E07B2A','#D4A017','#8B3A0F','#B85C00','#A0390A','#D96C1A'];

  var COUNT = 18;

  for(var i = 0; i < COUNT; i++){
    (function(i){
      var leaf = document.createElement('div');
      leaf.className = 'mtw-leaf';

      var size    = 14 + Math.random() * 18;          /* 14–32 px */
      var left    = Math.random() * 100;               /* % across */
      var dur     = 8 + Math.random() * 10;            /* 8–18 s */
      var delay   = -(Math.random() * dur);            /* stagger start */
      var swayPx  = (Math.random() < 0.5 ? -1 : 1) * (40 + Math.random() * 80);
      var spin    = (Math.random() < 0.5 ? -1 : 1) * (120 + Math.random() * 200);
      var color   = colors[Math.floor(Math.random() * colors.length)];
      var shape   = shapes[Math.floor(Math.random() * shapes.length)];

      leaf.style.cssText = [
        'left:' + left + '%',
        'width:' + size + 'px',
        'height:' + size + 'px',
        'animation-duration:' + dur + 's',
        'animation-delay:' + delay + 's',
        '--sway:' + swayPx + 'px',
        '--spin:' + spin + 'deg'
      ].join(';');

      leaf.innerHTML = '<svg viewBox="0 0 100 115" width="' + size + '" height="' + size + '" xmlns="http://www.w3.org/2000/svg">'
        + '<path d="' + shape + '" fill="' + color + '" opacity="0.85"/>'
        + '</svg>';

      container.appendChild(leaf);
    })(i);
  }
})();
</script>

{% schema %}
{
  "name": "Countdown — Halloween",
  "settings": [
    { "type": "select", "id": "bg_style", "label": "Background", "options": [
        { "value": "mtw-countdown--dark",  "label": "Dark (brown)" },
        { "value": "mtw-countdown--cream", "label": "Cream" }
      ], "default": "mtw-countdown--dark" },
    { "type": "text",    "id": "eyebrow",     "label": "Eyebrow",      "default": "Hello Harvest · Fall 2026" },
    { "type": "text",    "id": "headline",    "label": "Headline",     "default": "Order before Halloween." },
    { "type": "textarea","id": "subtext",     "label": "Subtext",      "default": "Install weeks are filling fast. Secure your display now — we handle everything." },
    { "type": "text",    "id": "cta_text",    "label": "Button label", "default": "Book your install" },
    { "type": "text",    "id": "cta_url",     "label": "Button URL",   "default": "/products/fall-favorite" },
    { "type": "text",    "id": "target_date", "label": "Target date",  "default": "October 31, 2026 23:59:59", "info": "Use format: Month DD, YYYY HH:MM:SS" },
    { "type": "text",    "id": "done_text",   "label": "Expired message", "default": "Season complete — see you next fall." }
  ],
  "presets": [{ "name": "Countdown — Halloween" }]
}
{% endschema %}

<section class="mtw-cta-dark">
  <div class="mtw-container">
    <div class="mtw-cta-dark__grid">

      <!-- Left: copy -->
      <div class="mtw-cta-dark__copy">
        <span class="mtw-mono mtw-eyebrow mtw-eyebrow--primary">{{ section.settings.eyebrow }}</span>
        <h2 class="mtw-cta-dark__headline">{{ section.settings.headline }}</h2>
        <div class="mtw-cta-dark__steps">
          {%- for block in section.blocks -%}
            <div class="mtw-cta-dark__step" {{ block.shopify_attributes }}>
              <span class="mtw-mono mtw-cta-dark__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
              <p class="mtw-cta-dark__step-text">{{ block.settings.text }}</p>
            </div>
          {%- endfor -%}
        </div>
      </div>

      <!-- Right: form — add Shopify Forms app block here via theme editor -->
      <div class="mtw-cta-dark__form-wrap">
        {%- for block in section.blocks -%}
          {%- if block.type == '@app' -%}
            {% render block %}
          {%- endif -%}
        {%- endfor -%}
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "CTA — Dark",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Fall 2026 · Tennessee"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "Welcome the fall season with a custom display."
    },
    {
      "type": "header",
      "content": "Waitlist form"
    },
    {
      "type": "text",
      "id": "form_title",
      "label": "Form title",
      "default": "Add Your Name"
    },
    {
      "type": "text",
      "id": "form_desc",
      "label": "Form description",
      "default": "We'll reach out in mid-August when ordering opens. No payment now."
    },
    {
      "type": "text",
      "id": "form_success_title",
      "label": "Success title",
      "default": "You're on the list."
    },
    {
      "type": "textarea",
      "id": "form_success_body",
      "label": "Success body",
      "default": "We'll be in touch in mid-August when ordering opens. No payment until then."
    }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "textarea",
          "id": "text",
          "label": "Step text",
          "default": "Step description."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "CTA — Dark",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "text": "Add your name — we'll reach out when ordering opens in mid-August"
          }
        },
        {
          "type": "step",
          "settings": {
            "text": "If you secure a spot, we'll confirm your delivery window and details"
          }
        },
        {
          "type": "step",
          "settings": {
            "text": "On your week, our designer arrives and installs your bespoke display in person"
          }
        }
      ]
    }
  ]
}
{% endschema %}

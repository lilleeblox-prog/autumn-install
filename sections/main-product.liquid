<div class="mtw-product" id="product-{{ product.id }}">
  <div class="mtw-container mtw-product__wrap">

    <!-- Image -->
    <div class="mtw-product__media">
      {%- if product.featured_image -%}
        <div class="mtw-product__img-wrap">
          {{ product.featured_image | image_url: width: 900 | image_tag: loading: 'eager', alt: product.title, class: 'mtw-product__img' }}
        </div>
      {%- endif -%}
    </div>

    <!-- Info + form -->
    <div class="mtw-product__info">

      <div class="mtw-product__meta">
        {%- if product.vendor != blank -%}
          <span class="mtw-mono mtw-product__vendor">{{ product.vendor }}</span>
        {%- endif -%}
        <h1 class="mtw-product__title">{{ product.title }}</h1>
        <p class="mtw-product__price" id="product-price">
          {{ product.selected_or_first_available_variant.price | money }}
        </p>
      </div>

      {%- if product.description != blank -%}
        <div class="mtw-product__desc">{{ product.description }}</div>
      {%- endif -%}

      <!-- What's included -->
      {%- assign include_blocks = section.blocks | where: 'type', 'include_item' -%}
      {%- if include_blocks.size > 0 -%}
        <div class="mtw-product__includes">
          <p class="mtw-product__label">What's included</p>
          <ul class="mtw-product__includes-list">
            {%- for block in include_blocks -%}
              {%- if block.settings.detail != blank -%}
                <li {{ block.shopify_attributes }}>{{ block.settings.detail }}</li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      <form class="mtw-product__form" id="product-form-{{ product.id }}">
        <input type="hidden" name="quantity" value="1">

        <!-- Variant selector -->
        {%- if product.variants.size > 1 -%}
          <div class="mtw-product__field">
            <label class="mtw-product__label" for="variant-select-{{ product.id }}">
              {{ product.options.first }}
            </label>
            <div class="mtw-product__select-wrap">
              <select
                id="variant-select-{{ product.id }}"
                name="id"
                class="mtw-product__select"
                data-product-id="{{ product.id }}"
              >
                {%- for variant in product.variants -%}
                  <option
                    value="{{ variant.id }}"
                    {%- if variant == product.selected_or_first_available_variant %} selected{%- endif -%}
                    {%- unless variant.available %} disabled{%- endunless -%}
                  >
                    {{ variant.title }} — {{ variant.price | money }}
                  </option>
                {%- endfor -%}
              </select>
            </div>
          </div>
        {%- else -%}
          <input type="hidden" name="id" value="{{ product.variants.first.id }}">
        {%- endif -%}

        <!-- Install week -->
        {%- assign weeks_raw = section.settings.install_weeks -%}
        {%- if weeks_raw != blank -%}
          {%- assign weeks = weeks_raw | newline_to_br | split: '<br />' -%}
          <div class="mtw-product__field">
            <label class="mtw-product__label" for="install-week-{{ product.id }}">
              Install week
            </label>
            <div class="mtw-product__select-wrap">
              <select id="install-week-{{ product.id }}" name="properties[Install week]" class="mtw-product__select" required>
                <option value="">Choose your week…</option>
                {%- for week in weeks -%}
                  {%- assign w = week | strip -%}
                  {%- unless w == blank -%}
                    <option value="{{ w }}">{{ w }}</option>
                  {%- endunless -%}
                {%- endfor -%}
              </select>
            </div>
            <p class="mtw-product__hint">We'll confirm your exact install date closer to the week.</p>
          </div>
        {%- endif -%}

        <!-- Zip code -->
        <div class="mtw-product__field">
          <label class="mtw-product__label" for="zip-{{ product.id }}">
            Delivery zip code
          </label>
          <input
            type="text"
            id="zip-{{ product.id }}"
            name="properties[Zip code]"
            class="mtw-product__input"
            inputmode="numeric"
            maxlength="5"
            placeholder="e.g. 37064"
            autocomplete="postal-code"
            required
          >
          <p class="mtw-product__hint" id="zip-hint-{{ product.id }}">Enter the zip code where we'll be installing.</p>
          <p class="mtw-product__zip-error" id="zip-error-{{ product.id }}" style="display:none">
            Sorry, we don't currently service that zip code. <a href="/pages/contact" class="mtw-product__zip-error-link">Contact us</a> if you think this is a mistake.
          </p>
        </div>

        <!-- Add-ons -->
        {%- assign addon_blocks = section.blocks | where: 'type', 'addon' -%}
        {%- if addon_blocks.size > 0 -%}
          <div class="mtw-product__field">
            <p class="mtw-product__label">Customize your order <span class="mtw-product__optional">(optional)</span></p>
            <div class="mtw-product__addons">
              {%- for block in addon_blocks -%}
                <div class="mtw-addon-wrap" {{ block.shopify_attributes }}>
                  <label class="mtw-addon">
                    <input
                      type="checkbox"
                      name="properties[Add-on: {{ block.settings.name }}]"
                      value="{{ block.settings.price }}"
                      class="mtw-addon__check{% if block.settings.is_removal or block.settings.name contains 'Removal' or block.settings.name contains 'removal' %} mtw-addon__check--removal{% endif %}"
                    >
                    <span class="mtw-addon__box"></span>
                    <span class="mtw-addon__text">
                      {{ block.settings.name }}
                      {%- if block.settings.price != blank -%}
                        <span class="mtw-addon__price">+ {{ block.settings.price }}</span>
                      {%- endif -%}
                      {%- if block.settings.note != blank -%}
                        <span class="mtw-addon__note">{{ block.settings.note }}</span>
                      {%- endif -%}
                    </span>
                  </label>
                  {%- if block.settings.is_removal or block.settings.name contains 'Removal' or block.settings.name contains 'removal' -%}
                    <div class="mtw-removal-week" style="display:none">
                      <p class="mtw-removal-week__label">Choose your removal week</p>
                      <select name="properties[Removal week]" class="mtw-product__select" disabled required>
                        <option value="">Select a week…</option>
                        <option value="Week of Nov 9">Week of Nov 9</option>
                        <option value="Week of Nov 16">Week of Nov 16</option>
                        <option value="Week of Nov 23">Week of Nov 23</option>
                        <option value="Week of Nov 30">Week of Nov 30</option>
                      </select>
                    </div>
                  {%- endif -%}
                </div>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}

        <!-- Notes -->
        {%- if section.settings.show_notes -%}
          <div class="mtw-product__field">
            <label class="mtw-product__label" for="notes-{{ product.id }}">
              Anything we should know? <span class="mtw-product__optional">(optional)</span>
            </label>
            <textarea
              id="notes-{{ product.id }}"
              name="properties[Notes]"
              class="mtw-product__textarea"
              rows="3"
              placeholder="Gate code, parking notes, porch layout…"
            ></textarea>
          </div>
        {%- endif -%}

        <button type="submit" class="mtw-btn mtw-btn--primary mtw-btn--full mtw-product__submit">
          {{ section.settings.cta_text | default: 'Book this package' }}
        </button>

        {%- if section.settings.reassurance != blank -%}
          <p class="mtw-product__reassurance">{{ section.settings.reassurance }}</p>
        {%- endif -%}

      </form>
    </div>
  </div>
</div>

<script>
  (function() {
    var select = document.getElementById('variant-select-{{ product.id }}');
    var priceEl = document.getElementById('product-price');
    var variants = {{ product.variants | json }};

    if (!select || !priceEl) return;

    select.addEventListener('change', function() {
      var chosen = variants.find(function(v){ return v.id == parseInt(select.value); });
      if (chosen) {
        priceEl.textContent = formatMoney(chosen.price);
      }
    });

    function formatMoney(cents) {
      return '$' + (cents / 100).toFixed(2).replace(/\.00$/, '');
    }
  })();

  // Zip validation
  (function() {
    var VALID_ZIPS = new Set([
      '37064','37179','37069','37174','37027',
      '37215','38401','37067','37046','38482','37221','37025','38476','37204','37062',
      '37211','37212','37220','37213','37205','37014','37219','37060','37203','37232',
      '37201','37238','38487','37029',
      '37208','37228','37082','37129','37128','37214','37153','37207','37210','37206',
      '37216','37209','37135','37034','37098','38474','37167','37217','37143','37091',
      '37055','37115','37180','37076','38451','37189','37132','38454','38461','37037'
    ]);

    var form   = document.getElementById('product-form-{{ product.id }}');
    var input  = document.getElementById('zip-{{ product.id }}');
    var hint   = document.getElementById('zip-hint-{{ product.id }}');
    var error  = document.getElementById('zip-error-{{ product.id }}');

    if (!form || !input) return;

    function validate() {
      var zip = input.value.trim();
      if (zip.length === 5 && !VALID_ZIPS.has(zip)) {
        input.classList.add('mtw-product__input--error');
        error.style.display = 'block';
        hint.style.display  = 'none';
        return false;
      } else {
        input.classList.remove('mtw-product__input--error');
        error.style.display = 'none';
        hint.style.display  = 'block';
        return true;
      }
    }

    input.addEventListener('input', function() {
      // only show error once they've typed 5 digits
      if (input.value.trim().length === 5) validate();
      else {
        input.classList.remove('mtw-product__input--error');
        error.style.display = 'none';
        hint.style.display  = 'block';
      }
    });

    form.addEventListener('submit', function(e) {
      if (!validate()) {
        e.preventDefault();
        input.focus();
      }
    });
  })();

  // AJAX add-to-cart — preserves ?preview_theme_id so cart page loads in the same theme
  (function() {
    var form = document.getElementById('product-form-{{ product.id }}');
    if (!form) return;

    form.addEventListener('submit', function(e) {
      e.preventDefault();

      var submitBtn = form.querySelector('[type="submit"]');
      var originalText = submitBtn ? submitBtn.textContent : '';
      if (submitBtn) { submitBtn.textContent = 'Adding…'; submitBtn.disabled = true; }

      var data = new FormData(form);

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'X-Requested-With': 'XMLHttpRequest' },
        body: data,
        credentials: 'same-origin'
      })
      .then(function(res) {
        if (!res.ok) return res.json().then(function(j) { throw new Error(j.description || 'Add to cart failed'); });
        // Preserve preview_theme_id if present so the cart page uses the same theme
        var params = new URLSearchParams(window.location.search);
        var cartUrl = '/cart';
        if (params.has('preview_theme_id')) {
          cartUrl += '?preview_theme_id=' + params.get('preview_theme_id');
        }
        window.location.href = cartUrl;
      })
      .catch(function(err) {
        if (submitBtn) { submitBtn.textContent = originalText; submitBtn.disabled = false; }
        alert(err.message || 'Could not add to cart. Please try again.');
      });
    });
  })();

  // Removal week picker
  (function() {
    document.querySelectorAll('.mtw-addon__check--removal').forEach(function(cb) {
      var wrap   = cb.closest('.mtw-addon-wrap');
      var picker = wrap && wrap.querySelector('.mtw-removal-week');
      var sel    = picker && picker.querySelector('select');
      if (!picker || !sel) return;
      cb.addEventListener('change', function() {
        picker.style.display = cb.checked ? 'block' : 'none';
        sel.disabled = !cb.checked;
        if (!cb.checked) sel.value = '';
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Product",
  "settings": [
    {
      "type": "textarea",
      "id": "install_weeks",
      "label": "Install weeks (one per line)",
      "default": "Sept 29 – Oct 3\nOct 6 – Oct 10\nOct 13 – Oct 17\nOct 20 – Oct 24\nOct 27 – Oct 31",
      "info": "Customers pick from this list when booking."
    },
    {
      "type": "checkbox",
      "id": "show_notes",
      "label": "Show 'anything we should know?' field",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button text",
      "default": "Book this package"
    },
    {
      "type": "text",
      "id": "reassurance",
      "label": "Reassurance line below button",
      "default": "We'll follow up to confirm your install week and details."
    }
  ],
  "blocks": [
    {
      "type": "include_item",
      "name": "Included item",
      "settings": [
        {
          "type": "text",
          "id": "detail",
          "label": "Item",
          "placeholder": "e.g. 6 Large Pumpkins"
        }
      ]
    },
    {
      "type": "addon",
      "name": "Add-on",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Hay Bale"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price (e.g. $40)",
          "default": "$40"
        },
        {
          "type": "text",
          "id": "note",
          "label": "Short note (optional)"
        },
        {
          "type": "checkbox",
          "id": "is_removal",
          "label": "Show removal week picker when selected",
          "default": false
        }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [{ "name": "Product" }]
}
{% endschema %}

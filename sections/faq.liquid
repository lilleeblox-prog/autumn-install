<style>
.faq-section { padding-top: clamp(64px, 8vw, 120px); padding-bottom: clamp(80px, 10vw, 144px); }
.faq-section .faq-header { max-width: 800px; margin-bottom: clamp(50px, 7vw, 94px); text-align: left; }
.faq-section .faq-header .eyebrow { margin-bottom: 0; }
.faq-section .faq-header h1, .faq-section .faq-header h2 {
  font-size: clamp(60px, 6vw, 80px); line-height: 1; letter-spacing: -.03em; margin: 16px 0 24px;
}
.faq-section .faq-header > p { max-width: 600px; color: var(--color-muted); font-size: 17px; line-height: 1.6; }
.faq-section .faq-list { border-top: 1px solid var(--color-border); }
.faq-section .faq-item { border-bottom: 1px solid var(--color-border); }
.faq-section .faq-item__question {
  display: flex; align-items: center; justify-content: space-between; gap: 40px;
  width: 100%; padding: 38px 0; text-align: left; background: none; border: none;
  color: var(--color-foreground); font: 400 clamp(40px, 4vw, 51px)/1.08 var(--font-serif);
  letter-spacing: -.03em; cursor: pointer; list-style: none;
}
.faq-section .faq-item__question::-webkit-details-marker { display: none; }
.faq-section .faq-item__question::marker { content: ''; }
.faq-section .faq-item__question > span { display: flex; align-items: baseline; gap: clamp(26px, 5vw, 80px); max-width: 970px; }
.faq-section .faq-number { color: var(--color-accent); font: 700 10px/1 var(--font-sans); letter-spacing: .13em; white-space: nowrap; }
.faq-section .faq-item__question::after {
  content: '+'; color: var(--color-accent); font: 400 28px/1 var(--font-sans);
  flex-shrink: 0; width: 25px; text-align: center;
}
.faq-section .faq-item[open] .faq-item__question::after { content: '−'; }
.faq-section .faq-item__question:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 4px; }
.faq-section .faq-item__answer {
  max-width: 790px; margin-left: min(21%, 270px); padding: 0 0 44px;
  color: var(--color-muted); font-size: 15px; line-height: 1.85;
}
.faq-section .faq-item__answer p:last-child { margin-bottom: 0; }
@media (max-width: 600px) {
  .faq-section .faq-header { margin-bottom: 48px; }
  .faq-section .faq-header h1, .faq-section .faq-header h2 { font-size: clamp(48px, 10vw, 60px); }
  .faq-section .faq-item__question { font-size: 33px; padding: 28px 0; gap: 20px; }
  .faq-section .faq-item__question > span { gap: 20px; }
  .faq-section .faq-item__answer { margin-left: 0; padding-bottom: 32px; font-size: 14px; }
}
</style>

<section class="faq-section container">
  <div class="faq-header">
    <div class="eyebrow">{{ section.settings.eyebrow | escape }}</div>
    {% if template.name == 'page' %}<h1>{{ section.settings.title | escape }}</h1>{% else %}<h2>{{ section.settings.title | escape }}</h2>{% endif %}
    {% if section.settings.intro != blank %}<p>{{ section.settings.intro | escape }}</p>{% endif %}
  </div>
  
  <div class="faq-list">
    {% for block in section.blocks %}
      <details class="faq-item" {% if forloop.first %}open{% endif %}>
        <summary class="faq-item__question"><span><small class="faq-number">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</small>{{ block.settings.question | escape }}</span></summary>
        <div class="faq-item__answer rte">
          {{ block.settings.answer }}
        </div>
      </details>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "The particulars / Good to know"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "A few good questions."
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Introduction",
      "default": "Everything you may want to know about materials, timing, installation and what it means to approve a design."
    }
  ],
  "blocks": [
    {
      "type": "qa",
      "name": "Q&A",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How long do the pumpkins last?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Longevity varies with weather and exposure. Contact the studio for care guidance specific to your entry.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ"
    }
  ]
}
{% endschema %}
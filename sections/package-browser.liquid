{% assign palette_names = 'Autumn in the Countryside|Classic Harvest|Coastal Cowgirl' | split: '|' %}
{% assign palette_descriptions = 'Burnt orange, soft white, and deep garden greens|Harvest orange, warm ivory, and golden gourds|Blush peach, ghost white, and sea-glass sage' | split: '|' %}
{% assign palette_colors = '#bd7439,#f0e8da,#819080,#415a50|#d67621,#f0e6d3,#cfaf6b,#995623|#dba99a,#f0e9dc,#a5b9a6,#6e8b75' | split: '|' %}
{% assign initial_scale = 'Choose a scale below' %}
{% assign initial_base_estimate_cents = 0 %}
{% assign package_count = 0 %}
{% assign monogram_product = section.settings.monogram_product %}
{% for block in section.blocks %}
  {% if block.type == 'package' %}{% assign package_count = package_count | plus: 1 %}{% endif %}
  {% if block.type == 'package' and block.settings.default_selected and initial_scale == 'Choose a scale below' %}
    {% assign initial_scale = block.settings.scale_name | default: block.settings.subtitle_fallback %}
    {% assign initial_base_estimate_cents = block.settings.draft_estimate_cents | default: 0 %}
    {% assign initial_product = block.settings.product %}
    {% if initial_product != blank and initial_product.price_min > 0 and initial_product.price_min == initial_product.price_max %}
      {% assign initial_base_estimate_cents = initial_product.price_min %}
    {% endif %}
  {% endif %}
{% endfor %}

<div id="{{ section.settings.section_id | default: 'compose' | escape }}" style="scroll-margin-top: 100px"></div>
<section class="palette-composer" id="PackageBrowser-{{ section.id }}" data-package-browser="{{ section.id }}" data-mobile-pane="build" data-review-stage="build">
  <nav class="palette-composer__tabs" aria-label="Builder views">
    <button type="button" aria-pressed="true" data-pane-tab="build">Create your look</button>
    <button type="button" aria-pressed="false" data-pane-tab="preview">See your design</button>
  </nav>
  <form class="palette-composer__form" method="post" action="{{ routes.cart_add_url }}" enctype="multipart/form-data" data-product-form data-product-title="{{ section.settings.title | escape }}" data-selected-scale-name="{{ initial_scale | escape }}" data-base-estimate-cents="{{ initial_base_estimate_cents }}">
    <input type="hidden" name="form_type" value="product">
    <input type="hidden" name="quantity" value="1">
    <input type="hidden" name="properties[_Composition ID]" value="" data-composition-id-input>
    <input type="hidden" name="properties[Hay Bales]" value="No" data-hay-property>
    <input type="hidden" name="properties[Palette]" value="" data-chosen-palette>
    <div class="palette-composer__editor" data-composer-pane="build" aria-label="Create your display">
      <header class="palette-composer__intro">
        <div class="eyebrow">{{ section.settings.eyebrow | escape }}</div>
        {% assign title_lines = section.settings.title | split: '|' %}
        <h1>{{ title_lines[0] | default: section.settings.title | escape }}{% if title_lines.size > 1 %}<em>{{ title_lines[1] | escape }}</em>{% endif %}</h1>
        <p>{{ section.settings.text | escape }}</p>
      </header>
      <div class="palette-composer__step">
        <span class="eyebrow">{{ section.settings.palette_heading | escape }}</span><h2>Begin with color.</h2>
        <p>From the warmth of harvest to a softer coastal note, find the shades you would love to come home to.</p>
        <fieldset class="palette-choices"><legend class="visually-hidden">Choose a color palette</legend>
          {% for palette in palette_names %}
            {% assign palette_index = forloop.index0 %}
            {% assign swatches = palette_colors[palette_index] | split: ',' %}
            <label class="palette-choice">
              <input type="radio" name="composer-palette-{{ section.id }}" value="{{ palette | escape }}" data-composer-palette data-color-list="{{ palette_colors[palette_index] | escape }}">
              <span class="palette-choice__swatches">{% for swatch in swatches %}<i style="background:{{ swatch }}"></i>{% endfor %}</span>
              <strong>{{ palette }}</strong><small>{{ palette_descriptions[palette_index] }}</small>
            </label>
          {% endfor %}
        </fieldset>
      </div>
      <div class="palette-composer__step">
        <span class="eyebrow">{{ section.settings.scale_eyebrow | escape }}</span><h2>{{ section.settings.scale_heading | escape }}</h2>
        <p>A narrow stoop, generous porch, or sweeping staircase—let the proportions of your home lead the way.</p>
        <div class="package-browser__grid">
          {% for block in section.blocks %}
            {% if block.type == 'package' %}
              {% assign prod = block.settings.product %}
              {% assign option_index = -1 %}
              {% if prod != blank %}{% for name in prod.options %}{% assign lower_name = name | downcase %}{% if lower_name contains 'palette' %}{% assign option_index = forloop.index0 %}{% endif %}{% endfor %}{% endif %}
              {% assign display_size = block.settings.service_fee_tier %}
              {% assign delivery = blank %}
              {% assign removal = blank %}
              {% assign expected_service_fee = 0 %}
              {% case display_size %}
                {% when 'small' %}{% assign delivery = section.settings.delivery_small_product %}{% assign removal = section.settings.removal_small_product %}{% assign expected_service_fee = 2500 %}
                {% when 'medium' %}{% assign delivery = section.settings.delivery_medium_product %}{% assign removal = section.settings.removal_medium_product %}{% assign expected_service_fee = 5000 %}
                {% when 'large' %}{% assign delivery = section.settings.delivery_large_product %}{% assign removal = section.settings.removal_large_product %}{% assign expected_service_fee = 8500 %}
              {% endcase %}
              <div class="package-card-shell" {{ block.shopify_attributes }}>
                <button type="button" class="package-card" data-composer-scale data-scale-name="{{ block.settings.scale_name | escape }}" data-display-size="{{ display_size }}" data-expected-service-fee="{{ expected_service_fee }}" data-base-estimate-cents="{% if prod != blank and prod.price_min > 0 and prod.price_min == prod.price_max %}{{ prod.price_min }}{% else %}{{ block.settings.draft_estimate_cents | default: 0 }}{% endif %}" data-product-id="{% if prod != blank %}{{ prod.id }}{% endif %}" data-product-title="{% if prod != blank %}{{ prod.title | escape }}{% else %}{{ block.settings.scale_name | escape }}{% endif %}" data-product-available="{% if prod != blank and prod.available and prod.published_at != blank %}true{% else %}false{% endif %}" data-palette-index="{{ option_index }}" data-variants="{% if prod != blank %}{{ prod.variants | json | escape }}{% endif %}" data-delivery-id="{% if delivery != blank and delivery.available and delivery.published_at != blank and delivery.selected_or_first_available_variant.price > 0 %}{{ delivery.selected_or_first_available_variant.id }}{% endif %}" data-delivery-price="{{ delivery.selected_or_first_available_variant.price | default: 0 }}" data-removal-id="{% if removal != blank and removal.available and removal.published_at != blank and removal.selected_or_first_available_variant.price > 0 %}{{ removal.selected_or_first_available_variant.id }}{% endif %}" data-removal-price="{{ removal.selected_or_first_available_variant.price | default: 0 }}" aria-pressed="{% if block.settings.default_selected %}true{% else %}false{% endif %}" aria-expanded="false" aria-controls="package-includes-{{ block.id }}">
                  {% if block.settings.most_popular %}<small class="package-card__popular">Most popular</small>{% endif %}
                  <span class="package-title">{{ block.settings.scale_name | escape }}</span>
                  <span class="package-room">{{ block.settings.room_fallback | default: block.settings.subtitle_fallback | escape }}</span>
                  <span class="package-card__hint"><span class="visually-hidden" data-scale-disclosure-label>Show package details</span><span class="package-card__hint-arrow" aria-hidden="true">›</span></span>
                </button>
                <div class="package-card-details" id="package-includes-{{ block.id }}" aria-labelledby="package-includes-title-{{ block.id }}" hidden>
                  <p id="package-includes-title-{{ block.id }}">Included in {{ block.settings.scale_name | escape }}</p>
                  {% assign included_items = block.settings.included_items | newline_to_br | split: '<br />' %}
                  <ul>{% for item in included_items %}{% assign line = item | strip %}{% if line != blank %}<li>{{ line | escape }}</li>{% endif %}{% endfor %}</ul>
                  <div class="package-card-details__availability">
                    <small data-scale-status role="status" aria-live="polite">{% if prod == blank %}Preview only · product not configured{% elsif prod.available == false or prod.published_at == blank %}Preview only · product not available{% elsif option_index < 0 %}Cannot order · a palette variant is required{% else %}Choose a palette to check ordering availability.{% endif %}</small>
                  </div>
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
      <div class="palette-composer__step">
        <span class="eyebrow">03 / The details</span><h2>A detail that’s yours.</h2>
        <p>A personal motif can make the welcome feel even more like home. Add your artwork in vinyl to a pumpkin, then choose its colors.</p>
        <fieldset class="composer-choice composer-choice--artwork composer-choice--full-card"><legend>Add a vinyl-wrapped artwork pumpkin?</legend>
          <label><input class="composer-hidden" type="radio" name="properties[Vinyl Artwork]" value="Yes" data-monogram-choice="yes" required><span>Yes, add my artwork</span><small>{% if monogram_product != blank and monogram_product.available and monogram_product.published_at != blank and monogram_product.selected_or_first_available_variant.price > 0 %}Your design, wrapped in vinyl on a pumpkin.{% else %}A preview for now; availability must be confirmed before ordering.{% endif %}</small></label>
          <label><input class="composer-hidden" type="radio" name="properties[Vinyl Artwork]" value="No" data-monogram-choice="no" required><span>No thanks</span><small>Keep the palette just as it is.</small></label>
        </fieldset>
        <div data-monogram-fields hidden>
          <label>Upload your artwork (PNG or PDF)<input type="file" name="properties[Artwork File]" accept=".png,.pdf,image/png,application/pdf" data-artwork-file></label>
          <label>How many pumpkins?<input type="number" name="properties[Vinyl-wrapped Pumpkins]" min="1" step="1" value="1" data-monogram-quantity></label>
          <label>Pumpkin color<select name="properties[Pumpkin Color Preference]" data-monogram-detail><option value="">Choose a pumpkin color</option><option>White</option><option>Orange</option></select></label>
          <label>Vinyl color<select name="properties[Vinyl Color Preference]" data-monogram-detail><option value="">Choose a vinyl color</option><option>White</option><option>Black</option><option>Gold</option></select></label>
          <p>One PNG or PDF, up to 20 MB. We’ll confirm your artwork and materials before production.</p>
        </div>
        <label class="composer-field">Your vision (optional)<textarea name="properties[General Notes]" rows="3" placeholder="The feeling, colors, event, or little details you're imagining..."></textarea></label>
        <div class="composer-consultation">
          <span class="eyebrow">Beyond the builder</span>
          <h3>Something only you could imagine?</h3>
          <p>A different scale, a distinctive doorway, a detail that makes it yours—tell us what you have in mind. We can explore the possibilities together before confirming scope, price, or timing.</p>
          <label class="composer-custom"><input type="checkbox" data-custom-request> I have a special request</label>
          <p data-custom-request-note hidden>A consultation is required for this request. Add details in “Your vision”; your chosen details will appear in the consultation draft. {% if pages.contact != blank %}<a href="{{ pages.contact.url }}#consultation-form" data-consultation-link>Continue to consultation draft →</a>{% else %}Please contact the studio before ordering.{% endif %}</p>
        </div>
        <div class="palette-composer__arrival">
          <span class="eyebrow">04 / The arrival</span>
          <h2>Make an entrance.</h2>
          <p>How would you like your display to arrive? Tell us the week you have in mind, and we’ll discuss the details with you.</p>
        </div>
        <fieldset class="composer-choice composer-choice--service composer-choice--full-card"><legend>Fulfillment method</legend>
          <label><input class="composer-hidden" type="radio" name="properties[Service]" value="Custom installation" data-service="install" required><span>Custom installation</span><small>We style the display at your entry.</small></label>
          <label><input class="composer-hidden" type="radio" name="properties[Service]" value="Delivery only" data-service="delivery" required><span>Delivery only</span><small>The pieces arrive for you to arrange.</small></label>
        </fieldset>
        <fieldset class="composer-week-choice">
          <legend data-requested-week-label>Requested delivery &amp; installation week</legend>
          <div class="composer-week-grid">
            {% for block in section.blocks %}
              {% if block.type == 'requested_week' and block.settings.week_label != blank and block.settings.week_value != blank %}
                <label class="composer-week-card" {{ block.shopify_attributes }}>
                  <input type="radio" name="properties[Requested Week]" value="{{ block.settings.week_value | escape }}" data-requested-week required>
                  <strong>{{ block.settings.week_label | escape }}</strong>
                </label>
              {% endif %}
            {% endfor %}
          </div>
          <small class="composer-field__hint">Choose the week you have in mind. This is a request, not a reservation; we’ll confirm the date and time with you. Have an event date? Add it to your notes above.</small>
        </fieldset>
        <fieldset class="composer-choice composer-choice--full-card"><legend>Removal service</legend>
          <label><input class="composer-hidden" type="radio" name="properties[Removal]" value="Yes" required><span>Please arrange removal</span><small>We’ll collect the display after the season.</small></label>
          <label><input class="composer-hidden" type="radio" name="properties[Removal]" value="No" required><span>I’ll handle it</span><small>Leave the end-of-season details to me.</small></label>
        </fieldset>
        <div class="composer-hidden" aria-hidden="true">
          <select name="id" data-base-variant><option value="" data-price="0">Choose a priced package</option></select>
        </div>
        {% assign mono_variant = monogram_product.selected_or_first_available_variant %}
        <div data-service-products data-display-size="" data-expected-service-fee="0" data-delivery-id="" data-delivery-price="0" data-monogram-id="{% if monogram_product.available and monogram_product.published_at != blank and mono_variant.price > 0 %}{{ mono_variant.id }}{% endif %}" data-monogram-price="{{ mono_variant.price | default: 0 }}" data-monogram-estimate-cents="{% if mono_variant.price > 0 %}{{ mono_variant.price }}{% else %}{{ section.settings.vinyl_estimate_cents | default: 0 }}{% endif %}" data-removal-id="" data-removal-price="0"></div>
      </div>
      <p class="package-browser__transfer-error" role="alert" data-consultation-transfer-error hidden>Choices could not be saved for consultation. Please enter them in the form yourself.</p>
      <div id="product-form-error" class="hidden" role="alert" aria-live="assertive" aria-atomic="true"></div>
      <div class="composer-editor-approval">
        <p>Ready to look at everything together? Review your choices and estimated total before continuing.</p>
        <button type="button" data-open-final-review>Approve final design</button>
      </div>
    </div>
    <aside class="palette-composer__preview" data-composer-pane="preview" aria-label="Live design review">
      <div class="palette-composer__preview-intro">
        <button type="button" data-edit-design>&larr; Edit design</button>
        <span class="eyebrow">Your entrance / In the making</span>
        <h2>{{ section.settings.summary_heading | escape }}</h2>
        <p>{{ section.settings.summary_disclosure | escape }}</p>
      </div>
      <div class="composition-summary" id="gallery">
        <div class="composition-summary__image" data-palette-browser-gallery aria-label="Selected palette photograph" hidden>
          <div class="palette-study__grid">
            {% for block in section.blocks %}
              {% if block.type == 'palette_image' and block.settings.image != blank or block.type == 'palette_image' and block.settings.reference_asset != blank and block.settings.reference_asset != 'none' %}
                <div class="palette-study__item hidden" data-palette="{{ block.settings.palette | escape }}" style="--palette-x: {{ block.settings.position_x | default: 50 }}%;--palette-y:{{ block.settings.position_y | default: 50 }}%;--palette-zoom:{{ block.settings.zoom | default: 100 | divided_by: 100.0 }};--palette-turn:{% if block.settings.flip_180 %}180deg{% else %}0deg{% endif %}">
                  {% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', alt: block.settings.image.alt, widths: '400, 700, 1000' }}{% else %}{% assign reference_image = block.settings.reference_asset | append: '.webp' %}<img src="{{ reference_image | asset_url }}" width="1000" height="667" loading="lazy" alt="{{ block.settings.palette | escape }} palette study">{% endif %}
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>
        <div class="eyebrow">The design you've made</div><h2>Review your design</h2>
        <div class="composition-summary__row" hidden><span>Palette</span><strong data-selected-palette></strong></div>
        <div class="composition-summary__row" hidden><span>Color story</span><strong data-selected-palette-description></strong></div>
        <div class="composition-summary__row"><span>Scale</span><strong data-selected-scale>{{ initial_scale | escape }}</strong></div>
        <div class="composition-summary__row" hidden><span>Fulfillment</span><strong data-brief-service></strong></div>
        <div class="composition-summary__row" hidden><span>Vinyl artwork</span><strong data-brief-monogram></strong></div>
        <div class="composition-summary__row" hidden><span>Requested week</span><strong data-brief-week></strong></div>
        <div class="composition-summary__row" hidden><span>Removal</span><strong data-brief-removal></strong></div>
        <div class="composition-summary__row" hidden><span>Artwork details</span><strong data-brief-artwork></strong></div>
        <div class="composition-summary__row" hidden><span>Notes</span><strong data-brief-notes></strong></div>
        <section class="composition-price-estimate" data-composition-estimate aria-label="Live price breakdown">
          <span class="eyebrow">Live estimate</span><div data-estimate-rows></div>
          <div class="composition-price-estimate__total"><span>Known subtotal</span><strong data-estimate-total aria-live="polite"></strong></div>
          <p class="composition-price-estimate__note" data-estimate-note>Unconfirmed service pricing is excluded. Taxes and shipping are calculated at checkout.</p>
        </section>
        <div class="composer-final-approval">
          <p class="product-approval-note" data-approval-disclosure>{{ section.settings.continue_disclosure | escape }} Preferred weeks require confirmation.</p>
          <p class="composer-review-error hidden" data-review-error role="alert" aria-live="assertive"></p>
          <div class="composer-review-actions">
            <button type="button" data-edit-design>Edit design</button>
            <button type="button" data-approve-design disabled>Approve</button>
          </div>
          <div class="product-approval" data-approval-status hidden role="status"><strong>Your design is ready to review</strong><p>Take a closer look at each part of your composition in the cart before checkout.</p></div>
          <button type="submit" data-cart-submit hidden>Review your composition</button>
        </div>
      </div>
    </aside>
  </form>
  <dialog class="cart-layout-dialog" data-cart-layout-dialog aria-labelledby="CartLayoutTitle-{{ section.id }}">
    <div class="cart-layout-dialog__top">
      <div><span class="eyebrow">A private look / Cart layout preview</span><h2 id="CartLayoutTitle-{{ section.id }}">Your design, gathered.</h2></div>
      <button type="button" class="cart-layout-dialog__close" data-cart-layout-close aria-label="Close cart layout preview">&times;</button>
    </div>
    <p class="cart-layout-dialog__notice"><strong>Preview only — this is not your Shopify cart.</strong><br>No items have been added. Prices, availability, and your requested week must be confirmed before ordering.</p>
    <dl class="cart-layout-dialog__details">
      <div><dt>Display</dt><dd data-draft-cart-scale></dd></div>
      <div><dt>Palette</dt><dd data-draft-cart-palette></dd></div>
      <div><dt>Fulfillment</dt><dd data-draft-cart-service></dd></div>
      <div><dt>Requested week</dt><dd data-draft-cart-week></dd></div>
      <div><dt>Vinyl artwork</dt><dd data-draft-cart-artwork></dd></div>
      <div><dt>Removal</dt><dd data-draft-cart-removal></dd></div>
      <div><dt>Notes</dt><dd data-draft-cart-notes></dd></div>
    </dl>
    <div data-draft-cart-lines></div>
    <div class="cart-layout-dialog__line cart-layout-dialog__total"><span>Known reference estimate</span><strong data-draft-cart-total></strong></div>
    <p class="cart-layout-dialog__note" data-draft-cart-note></p>
    <button type="button" class="button button--secondary" data-cart-layout-close>Return to your design</button>
  </dialog>
</section>

<script>
  window.shopMoneyFormat = window.shopMoneyFormat || {{ shop.money_format | json }};
  window.cartUrl = window.cartUrl || {{ routes.cart_url | json }};
  window.cartAddUrl = window.cartAddUrl || {{ routes.cart_add_url | json }};
  (() => {
    window.paletteInstallComposerInitializers = window.paletteInstallComposerInitializers || {};
    const sectionKey = '{{ section.id }}';
    if (window.paletteInstallComposerInitializers[sectionKey]) {
      window.paletteInstallComposerInitializers[sectionKey]();
      return;
    }
    const initialize = () => {
    if (!window.paletteInstallThemeReady || typeof window.formatMoney !== 'function') return;
    const root = document.querySelector('[data-package-browser="{{ section.id }}"]');
    if (!root || root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';
    const paletteNames = {{ palette_names | json }};
    const paletteDescriptions = {{ palette_descriptions | json }};
    const paletteRadios = root.querySelectorAll('[data-composer-palette]');
    const paletteImages = root.querySelectorAll('[data-palette-browser-gallery] [data-palette]');
    const selectedImage = root.querySelector('[data-palette-browser-gallery]');
    const selectedScale = root.querySelector('[data-selected-scale]');
    const cards = Array.from(root.querySelectorAll('[data-composer-scale]'));
    const form = root.querySelector('[data-product-form]');
    const variantSelect = form.querySelector('[data-base-variant]');
      const services = form.querySelector('[data-service-products]');
    const hayProperty = form.querySelector('[data-hay-property]');
    const paletteProperty = form.querySelector('[data-chosen-palette]');
    const radios = selector => form.querySelector(selector + ':checked');
    const text = name => new FormData(form).get(`properties[${name}]`) || '';
    const setBriefValue = (selector, value) => {
      const field = root.querySelector(selector);
      if (!field) return;
      field.textContent = value || '';
      field.closest('.composition-summary__row').hidden = !value;
    };
    let activeScale = null;
    const rememberSelection = () => {
      const palette = root.querySelector('[data-composer-palette]:checked')?.value;
      if (!palette) return;
      const choices = {
        display: activeScale?.dataset.scaleName || '',
        displaySize: activeScale?.dataset.displaySize || '',
        palette,
        service: text('Service'),
        artwork: text('Vinyl Artwork'),
        artworkSelected: !!form.querySelector('[data-artwork-file]')?.files?.[0],
        quantity: text('Vinyl-wrapped Pumpkins'),
        pumpkinColor: text('Pumpkin Color Preference'),
        vinylColor: text('Vinyl Color Preference'),
        week: text('Requested Week'),
        removal: text('Removal'),
        notes: text('General Notes'),
        custom: !!form.querySelector('[data-custom-request]')?.checked
      };
      try {
        sessionStorage.setItem('palette-install-consultation-v1', JSON.stringify({ savedAt: Date.now(), choices }));
        document.dispatchEvent(new Event('palette-install:consultation-updated'));
        const notice = root.querySelector('[data-consultation-transfer-error]');
        if (notice) notice.hidden = true;
      } catch {
        const notice = root.querySelector('[data-consultation-transfer-error]');
        if (notice) notice.hidden = false;
      }
    };
    const chosenVariant = (card, palette) => {
      const index = Number(card?.dataset.paletteIndex);
      if (!card || card.dataset.productAvailable !== 'true' || index < 0 || !palette) return null;
      try {
        return JSON.parse(card.dataset.variants || '[]').find(variant =>
          variant.options[index] === palette && variant.available && Number(variant.price) > 0
        ) || null;
      } catch { return null; }
    };
    const updateScaleAvailability = (card, palette) => {
      const details = card.closest('.package-card-shell');
      const status = details?.querySelector('[data-scale-status]');
      const variant = chosenVariant(card, palette);
      if (!status) return;
      if (!card.dataset.productId) status.textContent = 'Preview only · product not configured';
      else if (card.dataset.productAvailable !== 'true') status.textContent = 'Preview only · product not available';
      else if (Number(card.dataset.paletteIndex) < 0) status.textContent = 'Cannot order · a palette variant is required';
      else if (!palette) status.textContent = 'Choose a palette to check ordering availability.';
      else if (!variant) status.textContent = 'Preview only · no available, priced variant for this palette.';
      else status.textContent = 'Available · select this scale to continue.';
    };
    const updatePalette = (palette) => {
      let imageCount = 0;
      paletteImages.forEach((image) => {
        const match = image.dataset.palette === palette;
        image.classList.toggle('hidden', !match);
        if (match) imageCount += 1;
      });
      if (selectedImage) selectedImage.hidden = imageCount === 0;
      cards.forEach(card => updateScaleAvailability(card, palette));
      selectScale(activeScale || cards.find(card => card.getAttribute('aria-pressed') === 'true') || cards[0]);
    };
    const selectScale = card => {
      if (!card) return;
      activeScale = card;
      cards.forEach(item => item.setAttribute('aria-pressed', item === card ? 'true' : 'false'));
      if (selectedScale) selectedScale.textContent = card.dataset.scaleName;
      const palette = root.querySelector('[data-composer-palette]:checked')?.value;
      const variant = chosenVariant(card, palette);
      updateScaleAvailability(card, palette);
      variantSelect.replaceChildren(new Option('Choose a priced package', '', true, !variant));
      cards.forEach(item => {
        try {
          JSON.parse(item.dataset.variants || '[]').forEach(candidate => {
            if (!variantSelect.querySelector(`option[value="${CSS.escape(String(candidate.id))}"]`)) {
              const option = new Option(`${item.dataset.productTitle} · ${candidate.title}`, candidate.id);
              option.dataset.price = candidate.price;
              option.disabled = !candidate.available || Number(candidate.price) <= 0 ||
                item.dataset.productAvailable !== 'true' || Number(item.dataset.paletteIndex) < 0;
              option.dataset.productId = item.dataset.productId;
              option.dataset.productTitle = item.dataset.productTitle;
              variantSelect.add(option);
            }
          });
        } catch { /* Unconfigured products remain preview-only. */ }
      });
      if (variant) {
        variantSelect.value = String(variant.id);
      }
      form.dataset.productTitle = card.dataset.productTitle || card.dataset.scaleName || '';
      form.dataset.selectedScaleName = card.dataset.scaleName || '';
      form.dataset.baseEstimateCents = card.dataset.baseEstimateCents || '0';
      services.dataset.displaySize = card.dataset.displaySize || '';
      services.dataset.expectedServiceFee = card.dataset.expectedServiceFee || '0';
      services.dataset.deliveryId = card.dataset.deliveryId || '';
      services.dataset.deliveryPrice = card.dataset.deliveryPrice || '0';
      services.dataset.removalId = card.dataset.removalId || '';
      services.dataset.removalPrice = card.dataset.removalPrice || '0';
      hayProperty.value = ['medium', 'large'].includes(card.dataset.displaySize) ? 'Yes' : 'No';
      const selected = variantSelect.selectedOptions[0];
      const price = form.querySelector('[data-price-container]');
      if (price) price.textContent = selected && Number(selected.dataset.price) > 0
        ? formatMoney(selected.dataset.price, window.shopMoneyFormat)
        : 'Pricing to be confirmed';
      const availableToOrder = !!variant && !!services.dataset.deliveryId &&
        (text('Vinyl Artwork') !== 'Yes' || !!services.dataset.monogramId) &&
        (text('Removal') !== 'Yes' || !!services.dataset.removalId) &&
        Number(services.dataset.deliveryPrice) === Number(services.dataset.expectedServiceFee);
      root.dataset.cartPreviewOnly = availableToOrder ? 'false' : 'true';
      form.querySelectorAll('[data-approve-design]').forEach(button => {
        button.disabled = !palette;
        button.textContent = 'Approve';
      });
      form.querySelectorAll('[data-approval-disclosure]').forEach(note => {
        note.textContent = availableToOrder
          ? {{ section.settings.continue_disclosure | append: ' Preferred weeks require confirmation.' | json }}
          : 'Preview how your choices would appear in the cart. No products will be added, no order will be placed, and your requested week is not reserved.';
      });
      const sizeLabel = card.dataset.scaleName || '';
      root.dataset.productTitle = card.dataset.productTitle || sizeLabel;
      variantSelect.dispatchEvent(new Event('change', { bubbles: true }));
      updateBrief();
    };
    const updateBrief = () => {
      const paletteValue = root.querySelector('[data-composer-palette]:checked')?.value || '';
      paletteProperty.value = paletteValue;
      const selectedService = radios('[data-service]');
      const artwork = radios('[data-monogram-choice]');
      const week = text('Requested Week');
      const removal = radios('input[name="properties[Removal]"]');
      const index = paletteNames.indexOf(paletteValue);
      setBriefValue('[data-selected-palette]', paletteValue);
      setBriefValue('[data-selected-palette-description]', index >= 0 ? paletteDescriptions[index] : '');
      setBriefValue('[data-brief-service]', selectedService?.value);
      setBriefValue('[data-brief-monogram]', artwork?.value === 'Yes' ? 'Vinyl artwork' : artwork?.value === 'No' ? 'No artwork' : '');
      setBriefValue('[data-brief-week]', week);
      setBriefValue('[data-brief-removal]', removal?.value === 'Yes' ? 'Requested' : removal?.value === 'No' ? 'Not requested' : '');
      const file = form.querySelector('[data-artwork-file]')?.files?.[0];
      const qty = form.querySelector('[data-monogram-quantity]')?.value;
      const pumpkin = form.querySelector('[name="properties[Pumpkin Color Preference]"]')?.value;
      const vinyl = form.querySelector('[name="properties[Vinyl Color Preference]"]')?.value;
      const artworkDetails = artwork?.value === 'Yes'
        ? [qty ? `${qty} pumpkin${Number(qty) === 1 ? '' : 's'}` : '',
          pumpkin ? `${pumpkin} pumpkin` : '', vinyl ? `${vinyl} vinyl` : '', file?.name || ''].filter(Boolean).join(' · ')
        : '';
      setBriefValue('[data-brief-artwork]', artworkDetails);
      setBriefValue('[data-brief-notes]', text('General Notes').trim());
      const weekLabel = root.querySelector('[data-requested-week-label]');
      if (weekLabel) weekLabel.textContent = selectedService?.dataset.service === 'delivery'
        ? 'Requested delivery week'
        : 'Requested delivery & installation week';
      rememberSelection();
    };
    root.querySelector('[data-open-final-review]')?.addEventListener('click', () => {
      if (!form.checkValidity()) {
        const missingField = focusFirstInvalidComposerField(form);
        productFormError(form, `Please complete ${missingField || 'the highlighted choices'} before reviewing your design.`);
        return;
      }
      if (form.querySelector('[data-custom-request]')?.checked) {
        productFormError(form, 'A special request needs a consultation before it can be approved for cart review.');
        form.querySelector('[data-custom-request]')?.focus();
        return;
      }
      productFormError(form, '');
      root.dataset.reviewStage = 'final';
      root.dataset.mobilePane = 'preview';
      root.querySelectorAll('[data-pane-tab]').forEach(tab =>
        tab.setAttribute('aria-pressed', String(tab.dataset.paneTab === 'preview')));
      const previewPane = root.querySelector('[data-composer-pane="preview"]');
      if (previewPane) previewPane.scrollTop = 0;
      root.scrollIntoView({ block: 'start', behavior: 'smooth' });
      root.querySelector('[data-edit-design]')?.focus({ preventScroll: true });
    });
    root.querySelectorAll('[data-edit-design]').forEach(button => button.addEventListener('click', () => {
      root.dataset.reviewStage = 'build';
      root.dataset.mobilePane = 'build';
      root.querySelectorAll('[data-pane-tab]').forEach(tab =>
        tab.setAttribute('aria-pressed', String(tab.dataset.paneTab === 'build')));
      root.scrollIntoView({ block: 'start', behavior: 'smooth' });
    }));
    cards.forEach(card => card.addEventListener('click', () => {
      const shouldExpand = card.getAttribute('aria-expanded') !== 'true';
      cards.forEach(item => {
        const expanded = item === card && shouldExpand;
        item.setAttribute('aria-expanded', expanded ? 'true' : 'false');
        const details = item.closest('.package-card-shell')?.querySelector('.package-card-details');
        if (details) details.hidden = !expanded;
        const label = item.querySelector('[data-scale-disclosure-label]');
        if (label) label.textContent = expanded ? 'Hide package details' : 'Show package details';
      });
      selectScale(card);
    }));
    paletteRadios.forEach(radio => radio.addEventListener('change', () => {
      updatePalette(radio.value);
      updateBrief();
    }));
    form.addEventListener('input', updateBrief);
    form.addEventListener('change', event => {
      updateBrief();
      if (event.target.matches('[data-service], [data-monogram-choice], input[name="properties[Removal]"]')) {
        selectScale(activeScale);
      }
    });
    root.querySelectorAll('[data-pane-tab]').forEach(button => button.addEventListener('click', () => {
      root.dataset.mobilePane = button.dataset.paneTab;
      root.querySelectorAll('[data-pane-tab]').forEach(tab => tab.setAttribute('aria-pressed', tab === button ? 'true' : 'false'));
    }));
    const revealGalleryAnchor = () => {
      if (window.location.hash !== '#gallery' || !window.matchMedia('(max-width: 900px)').matches) return;
      root.dataset.mobilePane = 'preview';
      root.querySelectorAll('[data-pane-tab]').forEach(tab => {
        const selected = tab.dataset.paneTab === 'preview';
        tab.setAttribute('aria-pressed', selected ? 'true' : 'false');
      });
      requestAnimationFrame(() => root.querySelector('#gallery')?.scrollIntoView({ behavior: 'smooth', block: 'start' }));
    };
    window.addEventListener('hashchange', revealGalleryAnchor);
    revealGalleryAnchor();
    const defaultCard = cards.find(card => card.getAttribute('aria-pressed') === 'true') || cards[0];
    if (defaultCard) selectScale(defaultCard);
    const initialPalette = new URLSearchParams(window.location.search).get('palette');
    const initialRadio = Array.from(paletteRadios).find((radio) => radio.value === initialPalette);
    if (initialRadio) {
      initialRadio.checked = true;
      updatePalette(initialRadio.value);
    }
    };
    document.addEventListener('palette-install:theme-ready', initialize);
    document.addEventListener('shopify:section:load', initialize);
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initialize, { once: true });
    } else {
      initialize();
    }
    window.paletteInstallComposerInitializers[sectionKey] = initialize;
  })();
</script>


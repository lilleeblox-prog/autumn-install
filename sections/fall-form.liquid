<section id="reserve" class="mtw-section mtw-section--card-bg mtw-scroll-mt">
  <div class="mtw-container">
    <div class="mtw-two-col mtw-two-col--form">

      <!-- Left: context -->
      <div class="mtw-two-col__col">
        <span class="mtw-mono mtw-eyebrow mtw-eyebrow--muted">{{ section.settings.eyebrow }}</span>
        <h2 class="mtw-h2" style="margin-bottom:1.25rem">{{ section.settings.headline }}</h2>
        <p class="mtw-body mtw-text-muted" style="margin-bottom:2rem">
          {{ section.settings.body }}
        </p>
        <ul class="mtw-checklist mtw-checklist--compact">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
          {%- endfor -%}
        </ul>
      </div>

      <!-- Right: form -->
      <div class="mtw-two-col__col">
        <!-- Add Shopify Forms app block here via theme editor -->
        <div class="mtw-form-card">
          {%- for block in section.blocks -%}
            {%- if block.type == '@app' -%}
              {% render block %}
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Fall — Form",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Fall 2026 · Waitlist"
    },
    {
      "type": "textarea",
      "id": "headline",
      "label": "Headline",
      "default": "Your pumpkins, your gourds, your fall — reserved."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body text",
      "default": "We install a small number of homes per neighborhood each fall so every display gets the attention it deserves. Add your name and we'll reach out in mid-August when ordering opens with your package options."
    },
    {
      "type": "header",
      "content": "Waitlist form"
    },
    {
      "type": "text",
      "id": "form_title",
      "label": "Form title",
      "default": "Add Your Name"
    },
    {
      "type": "text",
      "id": "form_desc",
      "label": "Form description",
      "default": "We'll reach out in mid-August when ordering opens. No payment now."
    },
    {
      "type": "text",
      "id": "form_success_title",
      "label": "Success title",
      "default": "You're on the list."
    },
    {
      "type": "textarea",
      "id": "form_success_body",
      "label": "Success body",
      "default": "We'll be in touch in mid-August when ordering opens. No payment until then."
    }
  ],
  "blocks": [
    {
      "type": "checklist_item",
      "name": "Checklist item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Item text",
          "default": "Checklist item"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Fall — Form",
      "blocks": [
        {
          "type": "checklist_item",
          "settings": { "text": "You're on the list — no payment now" }
        },
        {
          "type": "checklist_item",
          "settings": { "text": "Fall packages open in mid-August" }
        },
        {
          "type": "checklist_item",
          "settings": { "text": "We reach out directly with your fall package options" }
        }
      ]
    }
  ]
}
{% endschema %}

<section id="reserve" class="mtw-section mtw-section--card-bg mtw-scroll-mt">
  <div class="mtw-container">
    <div class="mtw-two-col mtw-two-col--form">

      <!-- Left: context -->
      <div class="mtw-two-col__col">
        <span class="mtw-mono mtw-eyebrow mtw-eyebrow--muted">{{ section.settings.eyebrow }}</span>
        <h2 class="mtw-h2" style="margin-bottom:1.25rem">{{ section.settings.headline }}</h2>
        <p class="mtw-body mtw-text-muted" style="margin-bottom:2rem">
          {{ section.settings.body }}
        </p>
        <ul class="mtw-checklist mtw-checklist--compact">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
          {%- endfor -%}
        </ul>
      </div>

      <!-- Right: form -->
      <div class="mtw-two-col__col">
        <div class="mtw-form-card">
          {%- form 'contact', id: 'fall-reserve-form' -%}
            <input type="hidden" name="contact[season]" value="Fall 2026">
            <input type="hidden" name="contact[tags]" value="waitlist,fall-2026">

            {%- if form.posted_successfully? -%}
              <div class="mtw-form-success">
                <svg class="mtw-form-success__icon" width="56" height="56" viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <circle cx="28" cy="28" r="26" stroke="#7A9E82" stroke-width="1.5"/>
                  <path d="M17 28.5l8 8 14-16" stroke="#7A9E82" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <p class="mtw-form-success__title">{{ section.settings.form_success_title }}</p>
                <p class="mtw-form-success__body">{{ section.settings.form_success_body }}</p>
              </div>
            {%- else -%}
              <h3 class="mtw-form-title">{{ section.settings.form_title }}</h3>
              <p class="mtw-form-desc">{{ section.settings.form_desc }}</p>
              <div class="mtw-form-row mtw-form-row--2col">
                <div class="mtw-form-field">
                  <label class="mtw-label" for="fall-first-name">First name</label>
                  <input class="mtw-input" type="text" id="fall-first-name" name="contact[first_name]" placeholder="Jane" required>
                </div>
                <div class="mtw-form-field">
                  <label class="mtw-label" for="fall-last-name">Last name</label>
                  <input class="mtw-input" type="text" id="fall-last-name" name="contact[last_name]" placeholder="Smith" required>
                </div>
              </div>
              <div class="mtw-form-field">
                <label class="mtw-label" for="fall-email">Email</label>
                <input class="mtw-input" type="email" id="fall-email" name="contact[email]" placeholder="jane@example.com" required>
              </div>
              <div class="mtw-form-field">
                <label class="mtw-label" for="fall-phone">Phone</label>
                <input class="mtw-input" type="tel" id="fall-phone" name="contact[phone]" placeholder="(615) 555-0100" required>
              </div>
              <div class="mtw-form-field">
                <label class="mtw-label" for="fall-zip">Zip code</label>
                <input class="mtw-input" type="text" id="fall-zip" name="contact[zip_code]" placeholder="37064" required>
              </div>
              <button type="submit" class="mtw-btn mtw-btn--primary mtw-btn--full" style="margin-top:0.5rem">
                Submit
              </button>
            {%- endif -%}
          {%- endform -%}
        </div>
      </div>
    </div>
  </div>
<script>
  (function(){
    var success = document.querySelector('#reserve .mtw-form-success');
    if (success) {
      var left = document.querySelector('#reserve .mtw-two-col__col');
      if (left) left.style.display = 'none';
      var grid = document.querySelector('#reserve .mtw-two-col--form');
      if (grid) grid.style.justifyContent = 'center';
    }
  })();
</script>
</section>

{% schema %}
{
  "name": "Fall — Form",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Fall 2026 · Waitlist"
    },
    {
      "type": "textarea",
      "id": "headline",
      "label": "Headline",
      "default": "Your pumpkins, your gourds, your fall — reserved."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body text",
      "default": "We install a small number of homes per neighborhood each fall so every display gets the attention it deserves. Add your name and we'll reach out in mid-August when ordering opens with your package options."
    },
    {
      "type": "header",
      "content": "Waitlist form"
    },
    {
      "type": "text",
      "id": "form_title",
      "label": "Form title",
      "default": "Add Your Name"
    },
    {
      "type": "text",
      "id": "form_desc",
      "label": "Form description",
      "default": "We'll reach out in mid-August when ordering opens. No payment now."
    },
    {
      "type": "text",
      "id": "form_success_title",
      "label": "Success title",
      "default": "You're on the list."
    },
    {
      "type": "textarea",
      "id": "form_success_body",
      "label": "Success body",
      "default": "We'll be in touch in mid-August when ordering opens. No payment until then."
    }
  ],
  "blocks": [
    {
      "type": "checklist_item",
      "name": "Checklist item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Item text",
          "default": "Checklist item"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Fall — Form",
      "blocks": [
        {
          "type": "checklist_item",
          "settings": { "text": "You're on the list — no payment now" }
        },
        {
          "type": "checklist_item",
          "settings": { "text": "Fall packages open in mid-August" }
        },
        {
          "type": "checklist_item",
          "settings": { "text": "We reach out directly with your fall package options" }
        }
      ]
    }
  ]
}
{% endschema %}

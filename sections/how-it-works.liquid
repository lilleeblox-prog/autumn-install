<section class="mtw-section mtw-section--bordered">
  <div class="mtw-container">
    <div class="mtw-section-header">
      <span class="mtw-mono mtw-eyebrow mtw-eyebrow--primary">How it works</span>
      <h2 class="mtw-h2">Four steps from your inbox to your doorstep.</h2>
    </div>

    <div class="mtw-timeline">
      <div class="mtw-timeline__connector" aria-hidden="true"></div>

      <div class="mtw-timeline__step">
        <div class="mtw-timeline__num mtw-timeline__num--active">01</div>
        <div class="mtw-timeline__body">
          <h3 class="mtw-timeline__title">Join waitlist</h3>
          <p class="mtw-timeline__text">
            Add your name and we'll reach out in mid-August when ordering opens. No payment now — this is just your place on the list.
          </p>
          <div class="mtw-timeline__tag mtw-timeline__tag--active">Open now</div>
        </div>
      </div>

      <div class="mtw-timeline__step">
        <div class="mtw-timeline__num">02</div>
        <div class="mtw-timeline__body">
          <h3 class="mtw-timeline__title">Choose your package</h3>
          <p class="mtw-timeline__text">
            When ordering opens, we reach out with everything you need: package options, available install dates, and all the details.
          </p>
          <div class="mtw-timeline__tag">Opens mid-August</div>
        </div>
      </div>

      <div class="mtw-timeline__step">
        <div class="mtw-timeline__num">03</div>
        <div class="mtw-timeline__body">
          <h3 class="mtw-timeline__title">We arrive &amp; style</h3>
          <p class="mtw-timeline__text">
            Our team brings everything and arranges your display by hand, leaving your entry looking warm and ready for the season.
          </p>
          <div class="mtw-timeline__tag">Late Sept – Oct</div>
        </div>
      </div>

      <div class="mtw-timeline__step">
        <div class="mtw-timeline__num">04</div>
        <div class="mtw-timeline__body">
          <h3 class="mtw-timeline__title">Optional removal</h3>
          <p class="mtw-timeline__text">
            Add end-of-season pickup and everything is taken away as gently as it arrived. Nothing to store, nothing to manage.
          </p>
          <div class="mtw-timeline__tag">November · add-on</div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "How It Works",
  "settings": [],
  "presets": [
    { "name": "How It Works" }
  ]
}
{% endschema %}

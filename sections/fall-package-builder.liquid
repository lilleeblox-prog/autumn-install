{% assign inventory_count = 0 %}
{% assign addon_count = 0 %}
{% for block in section.blocks %}
  {% if block.settings.product != blank %}
    {% if block.settings.role == 'addon' %}
      {% assign addon_count = addon_count | plus: 1 %}
    {% else %}
      {% assign inventory_count = inventory_count | plus: 1 %}
    {% endif %}
  {% endif %}
{% endfor %}

{% if inventory_count > 0 or request.design_mode %}
<section class="mtw-byo" id="build-your-own" data-byo-section>
  <div class="mtw-container">
    <div class="mtw-byo__header">
      <span class="mtw-mono mtw-eyebrow mtw-eyebrow--primary">{{ section.settings.eyebrow }}</span>
      <h2 class="mtw-h2">{{ section.settings.headline }}</h2>
      <p class="mtw-body mtw-text-muted">{{ section.settings.intro }}</p>
    </div>

    {% if inventory_count > 0 %}
      <form class="mtw-byo__form" data-byo-form>
        <div class="mtw-byo__recommend">
          <div class="mtw-byo__recommend-copy">
            <span class="mtw-mono">Not sure how much you need?</span>
            <h3>Start with a porch recommendation.</h3>
            <p>Choose the space closest to yours. We’ll fill in a balanced starting mix, then you can adjust every item.</p>
          </div>
          <div class="mtw-byo__presets" role="group" aria-label="Recommended porch sizes">
            <button type="button" class="mtw-byo__preset" data-byo-preset="small">
              <strong>Small stoop</strong><span>Simple front-door accent</span><small data-preset-count="small"></small>
            </button>
            <button type="button" class="mtw-byo__preset" data-byo-preset="standard">
              <strong>Standard porch</strong><span>Full, balanced welcome</span><small data-preset-count="standard"></small>
            </button>
            <button type="button" class="mtw-byo__preset" data-byo-preset="large">
              <strong>Large porch</strong><span>Abundant, layered display</span><small data-preset-count="large"></small>
            </button>
            <button type="button" class="mtw-byo__preset mtw-byo__preset--clear" data-byo-preset="clear">
              <strong>Start empty</strong><span>Choose every piece yourself</span>
            </button>
          </div>
          <p class="mtw-byo__preset-note" data-byo-preset-note aria-live="polite">Pick a recommendation or start adding pieces below.</p>
        </div>

        <div class="mtw-byo__step">
          <div class="mtw-byo__step-heading">
            <span class="mtw-byo__step-number">01</span>
            <div><h3>Choose your pumpkins</h3><p>Use the plus and minus buttons for each item. Your total updates automatically.</p></div>
          </div>
          <div class="mtw-byo__grid">
            {% for block in section.blocks %}
              {% assign chosen_product = block.settings.product %}
              {% if block.settings.role == 'inventory' and chosen_product != blank %}
                {% assign chosen_variant = chosen_product.selected_or_first_available_variant %}
                <article class="mtw-byo__item{% unless chosen_variant.available %} mtw-byo__item--sold{% endunless %}" {{ block.shopify_attributes }}>
                  <input type="checkbox" class="mtw-byo__inventory-choice" aria-hidden="true" tabindex="-1" data-byo-choice data-role="inventory" data-variant-id="{{ chosen_variant.id }}" data-title="{{ block.settings.title | default: chosen_product.title | escape }}" data-price="{{ chosen_variant.price }}" data-recommendation-key="{{ block.settings.recommendation_key }}" {% unless chosen_variant.available %}disabled{% endunless %}>
                  {% if block.settings.badge != blank %}<span class="mtw-byo__badge">{{ block.settings.badge }}</span>{% endif %}
                  {% if chosen_product.featured_image %}
                    <img class="mtw-byo__image" src="{{ chosen_product.featured_image | image_url: width: 600 }}" alt="{{ chosen_product.title | escape }}" loading="lazy">
                  {% endif %}
                  <div class="mtw-byo__item-body">
                    <div class="mtw-byo__item-top"><h4>{{ block.settings.title | default: chosen_product.title }}</h4><span>{{ chosen_variant.price | money }} each</span></div>
                    {% if block.settings.description != blank %}<p>{{ block.settings.description }}</p>{% endif %}
                    <div class="mtw-byo__quantity" data-byo-quantity>
                      <button type="button" data-quantity-minus aria-label="Remove one {{ block.settings.title | default: chosen_product.title | escape }}" disabled>−</button>
                      <input type="number" value="0" min="0" max="{{ block.settings.max_quantity }}" step="1" readonly data-quantity-input aria-label="Quantity of {{ block.settings.title | default: chosen_product.title | escape }}">
                      <button type="button" data-quantity-plus aria-label="Add one {{ block.settings.title | default: chosen_product.title | escape }}" {% unless chosen_variant.available %}disabled{% endunless %}>+</button>
                    </div>
                  </div>
                </article>
              {% endif %}
            {% endfor %}
          </div>
        </div>

        {% if addon_count > 0 %}
          <div class="mtw-byo__step mtw-byo__step--addons">
            <div class="mtw-byo__step-heading">
              <span class="mtw-byo__step-number">02</span>
              <div><h3>Make it complete</h3><p>Add the services and finishing touches you want.</p></div>
            </div>
            <div class="mtw-byo__addons">
              {% for block in section.blocks %}
                {% assign chosen_product = block.settings.product %}
                {% if block.settings.role == 'addon' and chosen_product != blank %}
                  {% assign chosen_variant = chosen_product.selected_or_first_available_variant %}
                  <label class="mtw-byo__addon{% unless chosen_variant.available %} mtw-byo__item--sold{% endunless %}" {{ block.shopify_attributes }}>
                    <input type="checkbox" aria-label="Add {{ block.settings.title | default: chosen_product.title | escape }}" data-byo-choice data-role="addon" data-variant-id="{{ chosen_variant.id }}" data-title="{{ block.settings.title | default: chosen_product.title | escape }}" data-price="{{ chosen_variant.price }}" data-recommendation-key="{{ block.settings.recommendation_key }}" {% unless chosen_variant.available %}disabled{% endunless %}>
                    <span class="mtw-byo__check" aria-hidden="true"></span>
                    <span class="mtw-byo__addon-copy"><strong>{{ block.settings.title | default: chosen_product.title }}</strong>{% if block.settings.description != blank %}<small>{{ block.settings.description }}</small>{% endif %}</span>
                    <span class="mtw-byo__addon-price">+{{ chosen_variant.price | money }}</span>
                  </label>
                {% endif %}
              {% endfor %}
            </div>
          </div>
        {% endif %}

        <div class="mtw-byo__checkout">
          <div aria-live="polite"><span class="mtw-mono">Your custom package</span><strong data-byo-total>{{ 0 | money }}</strong><small data-byo-count>Choose at least one fall piece to begin.</small></div>
          <button type="submit" class="mtw-btn mtw-btn--primary" data-byo-submit disabled>{{ section.settings.cart_label }}</button>
        </div>
        <p class="mtw-byo__error" data-byo-error role="alert" hidden></p>
      </form>
    {% elsif request.design_mode %}
      <div class="mtw-byo__empty">
        <p>Add Shopify products to this section in the theme editor to open the package builder.</p>
      </div>
    {% endif %}

    {% if section.settings.show_assisted %}
      <div class="mtw-byo__assisted">
        <div><span class="mtw-mono">{{ section.settings.assisted_eyebrow }}</span><h3>{{ section.settings.assisted_title }}</h3><p>{{ section.settings.assisted_text }}</p></div>
        <a class="mtw-btn mtw-btn--outline" href="{{ section.settings.assisted_url }}">{{ section.settings.assisted_label }}</a>
      </div>
    {% endif %}
  </div>
</section>
{% endif %}

<script>
(() => {
  const section = document.querySelector('[data-byo-section]');
  if (!section || section.dataset.ready) return;
  section.dataset.ready = 'true';
  const form = section.querySelector('[data-byo-form]');
  if (!form) return;
  const choices = [...form.querySelectorAll('[data-byo-choice]')];
  const total = form.querySelector('[data-byo-total]');
  const count = form.querySelector('[data-byo-count]');
  const submit = form.querySelector('[data-byo-submit]');
  const error = form.querySelector('[data-byo-error]');
  const money = cents => new Intl.NumberFormat(document.documentElement.lang || 'en-US', { style: 'currency', currency: {{ cart.currency.iso_code | default: shop.currency | json }} }).format(cents / 100);
  const normalizedQuantity = input => {
    if (!input) return 1;
    const min = Number(input.min) || 0;
    const max = Number(input.max) || 50;
    const entered = Math.round(Number(input.value));
    const value = Math.min(max, Math.max(min, Number.isFinite(entered) ? entered : min));
    input.value = value;
    return value;
  };

  const refresh = () => {
    let sum = 0, pieces = 0;
    choices.forEach(choice => {
      const item = choice.closest('.mtw-byo__item');
      const qtyWrap = item && item.querySelector('[data-byo-quantity]');
      const qty = qtyWrap ? normalizedQuantity(qtyWrap.querySelector('[data-quantity-input]')) : 1;
      if (qtyWrap) {
        choice.checked = qty > 0;
        item.classList.toggle('is-selected', qty > 0);
        qtyWrap.querySelector('[data-quantity-minus]').disabled = qty === 0;
        qtyWrap.querySelector('[data-quantity-plus]').disabled = qty >= Number(qtyWrap.querySelector('[data-quantity-input]').max);
      }
      if (choice.checked) {
        sum += Number(choice.dataset.price) * qty;
        if (choice.dataset.role === 'inventory') pieces += qty;
      }
    });
    total.textContent = money(sum);
    count.textContent = pieces ? `${pieces} fall piece${pieces === 1 ? '' : 's'} selected` : 'Choose at least one fall piece to begin.';
    submit.disabled = pieces === 0;
  };

  form.querySelectorAll('[data-quantity-minus], [data-quantity-plus]').forEach(button => button.addEventListener('click', () => {
    const input = button.parentElement.querySelector('[data-quantity-input]');
    const next = Number(input.value) + (button.hasAttribute('data-quantity-plus') ? 1 : -1);
    input.value = next;
    normalizedQuantity(input);
    refresh();
  }));
  choices.filter(choice => choice.dataset.role === 'addon').forEach(choice => choice.addEventListener('change', refresh));
  form.querySelectorAll('[data-quantity-input]').forEach(input => input.addEventListener('change', refresh));

  const inventoryChoices = choices.filter(choice => choice.dataset.role === 'inventory' && !choice.disabled);
  const recommendationRecipes = {
    small: { 'large-orange': 2, 'medium-orange': 2, 'white-ghost': 2, minis: 6 },
    standard: { 'large-orange': 4, 'medium-orange': 4, 'white-ghost': 4, minis: 12 },
    large: { 'large-orange': 8, 'medium-orange': 8, 'white-ghost': 6, minis: 15, 'hay-bales': 4 }
  };
  const recommendationKey = choice => {
    if (choice.dataset.recommendationKey && choice.dataset.recommendationKey !== 'none') return choice.dataset.recommendationKey;
    const title = choice.dataset.title.toLowerCase();
    if ((title.includes('large') || title.includes('lrg')) && title.includes('orange')) return 'large-orange';
    if ((title.includes('medium') || title.includes('med')) && title.includes('orange')) return 'medium-orange';
    if (title.includes('ghost') || title.includes('polar')) return 'white-ghost';
    if (title.includes('mini')) return 'minis';
    if (title.includes('hay') && title.includes('bale')) return 'hay-bales';
    return 'none';
  };
  ['small', 'standard', 'large'].forEach(size => {
    const recommendedPieces = inventoryChoices.reduce((sum, choice) => {
      const input = choice.closest('.mtw-byo__item').querySelector('[data-quantity-input]');
      const recommended = recommendationRecipes[size][recommendationKey(choice)] || 0;
      return sum + Math.min(recommended, Number(input.max));
    }, 0);
    const label = form.querySelector(`[data-preset-count="${size}"]`);
    if (label) label.textContent = `${recommendedPieces} pieces`;
  });
  form.querySelectorAll('[data-byo-preset]').forEach(button => button.addEventListener('click', () => {
    const size = button.dataset.byoPreset;
    inventoryChoices.forEach(choice => {
      const input = choice.closest('.mtw-byo__item').querySelector('[data-quantity-input]');
      input.value = size === 'clear' ? 0 : recommendationRecipes[size][recommendationKey(choice)] || 0;
    });
    form.querySelectorAll('[data-byo-preset]').forEach(option => option.classList.toggle('is-active', option === button));
    const note = form.querySelector('[data-byo-preset-note]');
    note.textContent = size === 'clear' ? 'Your builder is empty. Add exactly the pieces you want.' : `${button.querySelector('strong').textContent} recommendation added. Adjust anything below.`;
    refresh();
    form.querySelector('.mtw-byo__step').scrollIntoView({ behavior: 'smooth', block: 'start' });
  }));

  form.addEventListener('submit', async event => {
    event.preventDefault();
    const selectedInventory = choices.filter(choice => choice.checked && choice.dataset.role === 'inventory');
    if (!selectedInventory.length) return;
    submit.disabled = true;
    submit.textContent = 'Adding your package…';
    error.hidden = true;
    const packageName = 'Build Your Own Fall Package';
    const items = choices.filter(choice => choice.checked).map((choice, index) => {
      const item = choice.closest('.mtw-byo__item');
      const qtyInput = item && item.querySelector('[data-quantity-input]');
      const properties = { 'Package': packageName };
      if (index > 0 || choice.dataset.role === 'addon') {
        properties['_Package'] = selectedInventory[0].dataset.title;
        properties['_Customization'] = choice.dataset.title;
      }
      return { id: Number(choice.dataset.variantId), quantity: normalizedQuantity(qtyInput), properties };
    });
    try {
      const response = await fetch(`${window.Shopify?.routes?.root || '/'}cart/add.js`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ items })
      });
      if (!response.ok) throw new Error((await response.json()).description || 'Unable to add this package.');
      window.location.href = `${window.Shopify?.routes?.root || '/'}cart`;
    } catch (err) {
      error.textContent = err.message;
      error.hidden = false;
      submit.disabled = false;
      submit.textContent = {{ section.settings.cart_label | json }};
    }
  });
  refresh();
})();
</script>

{% schema %}
{
  "name": "Fall — Build your own",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Build your own" },
    { "type": "text", "id": "headline", "label": "Headline", "default": "Create a fall display that fits your space." },
    { "type": "textarea", "id": "intro", "label": "Introduction", "default": "Choose exactly what you want, see your total as you go, and add your finished package directly to cart." },
    { "type": "text", "id": "cart_label", "label": "Cart button", "default": "Add custom package to cart" },
    { "type": "checkbox", "id": "show_assisted", "label": "Show assisted-order card", "default": false },
    { "type": "text", "id": "assisted_eyebrow", "label": "Assisted-order eyebrow", "default": "Prefer a little help?" },
    { "type": "text", "id": "assisted_title", "label": "Assisted-order title", "default": "We can build it for you." },
    { "type": "textarea", "id": "assisted_text", "label": "Assisted-order text", "default": "Tell us about your space and budget. We’ll assemble your custom package and email a Shopify invoice that is ready to pay." },
    { "type": "text", "id": "assisted_label", "label": "Assisted-order button", "default": "Have us build my package" },
    { "type": "url", "id": "assisted_url", "label": "Assisted-order link" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Inventory item or add-on",
      "settings": [
        { "type": "product", "id": "product", "label": "Shopify product" },
        { "type": "select", "id": "role", "label": "Type", "default": "inventory", "options": [{ "value": "inventory", "label": "Fall inventory" }, { "value": "addon", "label": "Add-on or service" }] },
        { "type": "text", "id": "title", "label": "Display title override" },
        { "type": "textarea", "id": "description", "label": "Short sales description" },
        { "type": "text", "id": "badge", "label": "Optional badge", "info": "Examples: Best value, Most popular" },
        { "type": "range", "id": "max_quantity", "label": "Maximum quantity", "min": 1, "max": 50, "step": 1, "default": 12 },
        { "type": "header", "content": "Porch recommendations" },
        { "type": "select", "id": "recommendation_key", "label": "Recommendation category", "default": "none", "info": "Assign the matching category so the porch-size buttons add the correct quantity.", "options": [
          { "value": "none", "label": "Not used in recommendations" },
          { "value": "large-orange", "label": "Large orange" },
          { "value": "medium-orange", "label": "Medium orange" },
          { "value": "white-ghost", "label": "White ghost" },
          { "value": "minis", "label": "Minis" },
          { "value": "hay-bales", "label": "Hay bales" }
        ] }
      ]
    }
  ],
  "max_blocks": 24,
  "presets": [{ "name": "Fall — Build your own" }]
}
{% endschema %}
<section class="mtw-section mtw-coming-soon">
  <div class="mtw-container">
    <div class="mtw-coming-soon__header">
      <span class="mtw-badge mtw-badge--sage">Coming Soon</span>
      <h1 class="mtw-coming-soon__headline">{{ section.settings.headline }}</h1>
      <p class="mtw-coming-soon__sub">{{ section.settings.subheading }}</p>
    </div>

    <div class="mtw-two-col mtw-two-col--asymmetric">
      <div class="mtw-two-col__col">
        <h2 class="mtw-h3">What to expect</h2>
        <div class="mtw-prose">
          <p>{{ section.settings.description }}</p>
          <p class="mtw-body-sm" style="padding-top:0.5rem">
            Reserve your zip code below and we will confirm availability in your area when this service launches.
          </p>
        </div>
      </div>

      <!-- Add Shopify Forms app block here via theme editor -->
      <div class="mtw-two-col__col">
        <div class="mtw-form-card">
          {%- for block in section.blocks -%}
            {%- if block.type == '@app' -%}
              {% render block %}
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Coming Soon",
  "settings": [
    { "type": "text",     "id": "headline",         "label": "Headline",          "default": "Winter service" },
    { "type": "textarea", "id": "subheading",        "label": "Subheading",        "default": "Beautiful garland, installed and dressed for the season, then quietly removed when the holidays are over." },
    { "type": "textarea", "id": "description",       "label": "Description",       "default": "Our winter service brings beautifully dressed garland to your home, installed by hand and removed when the season ends. Full details will be shared when the service opens." },
    { "type": "text",     "id": "season_tag",        "label": "Season tag",        "default": "Winter 2026" },
    { "type": "text",     "id": "form_description",  "label": "Form description",  "default": "We'll confirm availability in your neighborhood when this service launches." }
  ],
  "blocks": [
    { "type": "@app" }
  ],
  "presets": [
    { "name": "Coming Soon" }
  ]
}
{% endschema %}

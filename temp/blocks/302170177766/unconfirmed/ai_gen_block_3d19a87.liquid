                </svg>
              {% elsif block.settings.step_2_icon == 'cart' %}
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
                </svg>
              {% elsif block.settings.step_2_icon == 'check' %}
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              {% endif %}
            </div>
          {% endif %}
          {% if block.settings.step_2_title != blank %}
            <h3 class="ai-how-it-works__step-title-{{ ai_gen_id }}">{{ block.settings.step_2_title }}</h3>
          {% endif %}
          {% if block.settings.step_2_description != blank %}
            <div class="ai-how-it-works__step-description-{{ ai_gen_id }}">{{ block.settings.step_2_description }}</div>
          {% endif %}
        </div>
      {% endif %}

      {% if block.settings.step_3_enabled %}
        <div class="ai-how-it-works__step-{{ ai_gen_id }}">
          {% if block.settings.show_numbers %}
            <div class="ai-how-it-works__step-number-{{ ai_gen_id }}">3</div>
          {% endif %}
          {% if block.settings.step_3_icon != 'none' %}
            <div class="ai-how-it-works__step-icon-{{ ai_gen_id }}">
              {% if block.settings.step_3_icon == 'email' %}
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              {% elsif block.settings.step_3_icon == 'bell' %}
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />

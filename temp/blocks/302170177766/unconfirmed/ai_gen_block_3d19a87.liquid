{% doc %}
  @prompt
    I need to generate a "how it works" post waitlist, for orders
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-how-it-works-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 20px;
    background-color: {{ block.settings.background_color }};
    margin: 0 auto;
  }

  .ai-how-it-works__container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-how-it-works__header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-how-it-works__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 16px;
    font-weight: 600;
  }

  .ai-how-it-works__subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.subtitle_color }};
    margin: 0;
    line-height: 1.6;
  }

  .ai-how-it-works__steps-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.step_gap }}px;
    margin-top: {{ block.settings.steps_top_margin }}px;
  }

  .ai-how-it-works__step-{{ ai_gen_id }} {
    background-color: {{ block.settings.step_background }};
    padding: {{ block.settings.step_padding }}px;
    border-radius: {{ block.settings.step_border_radius }}px;
    text-align: center;
    position: relative;
    border: {{ block.settings.step_border_width }}px solid {{ block.settings.step_border_color }};
  }

  .ai-how-it-works__step-number-{{ ai_gen_id }} {
    width: {{ block.settings.number_size }}px;
    height: {{ block.settings.number_size }}px;
    background-color: {{ block.settings.number_background }};
    color: {{ block.settings.number_color }};
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: {{ block.settings.number_font_size }}px;
    font-weight: 700;
    margin: 0 auto {{ block.settings.number_spacing }}px;
  }

  .ai-how-it-works__step-icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    margin: 0 auto {{ block.settings.icon_spacing }}px;
    color: {{ block.settings.icon_color }};
  }

  .ai-how-it-works__step-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
  }

  .ai-how-it-works__step-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.step_title_size }}px;
    color: {{ block.settings.step_title_color }};
    margin: 0 0 12px;
    font-weight: 600;
  }

  .ai-how-it-works__step-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.step_description_size }}px;
    color: {{ block.settings.step_description_color }};
    line-height: 1.6;
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-how-it-works__steps-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }

    .ai-how-it-works__title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.8);
    }

    .ai-how-it-works__subtitle-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subtitle_size }}px * 0.9);
    }
  }
{% endstyle %}

<how-it-works-{{ ai_gen_id }} class="ai-how-it-works-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-how-it-works__container-{{ ai_gen_id }}">
    {% if block.settings.title != blank or block.settings.subtitle != blank %}
      <div class="ai-how-it-works__header-{{ ai_gen_id }}">
        {% if block.settings.title != blank %}
          <h2 class="ai-how-it-works__title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
        {% endif %}
        {% if block.settings.subtitle != blank %}
          <div class="ai-how-it-works__subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-how-it-works__steps-{{ ai_gen_id }}">
      {% if block.settings.step_1_enabled %}
        <div class="ai-how-it-works__step-{{ ai_gen_id }}">
          {% if block.settings.show_numbers %}
            <div class="ai-how-it-works__step-number-{{ ai_gen_id }}">1</div>

                </svg>
              {% endif %}
            </div>
          {% endif %}
          {% if block.settings.step_3_title != blank %}
            <h3 class="ai-how-it-works__step-title-{{ ai_gen_id }}">{{ block.settings.step_3_title }}</h3>
          {% endif %}
          {% if block.settings.step_3_description != blank %}
            <div class="ai-how-it-works__step-description-{{ ai_gen_id }}">{{ block.settings.step_3_description }}</div>
          {% endif %}
        </div>
      {% endif %}

      {% if block.settings.step_4_enabled %}
        <div class="ai-how-it-works__step-{{ ai_gen_id }}">
          {% if block.settings.show_numbers %}
            <div class="ai-how-it-works__step-number-{{ ai_gen_id }}">4</div>
          {% endif %}
          {% if block.settings.step_4_icon != 'none' %}
            <div class="ai-how-it-works__step-icon-{{ ai_gen_id }}">
              {% if block.settings.step_4_icon == 'email' %}
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
